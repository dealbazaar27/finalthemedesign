{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_price = selected_variant.compare_at_price
  
  assign featured_img = selected_variant.featured_image
  if featured_img == blank
    assign featured_img = product.featured_media.preview_image
  endif
%}

<style>
  .predictive-search-product-card {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 14px !important;
    padding: 12px 16px !important;
    background: #ffffff !important;
    border-radius: 16px !important;
    border: 1px solid #e2e8f0 !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
    width: 100% !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03) !important;
    margin-bottom: 12px !important;
  }

  .predictive-search-product-card:hover {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06) !important;
    transform: translateY(-1px) !important;
  }

  .predictive-search-product-card__left {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    flex: 1 !important;
    min-width: 0 !important;
  }

  .predictive-search-product-card__image-wrapper {
    width: 60px !important;
    height: 60px !important;
    min-width: 60px !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    background: #f8fafc !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    border: 1px solid #e2e8f0 !important;
  }

  .predictive-search-product-card__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .predictive-search-product-card__placeholder {
    font-size: 1.5rem !important;
  }

  .predictive-search-product-card__content {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    gap: 4px !important;
    overflow: hidden !important;
    flex: 1 !important;
    min-width: 0 !important;
  }

  .predictive-search-product-card__title {
    font-size: 0.92rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    line-height: 1.35 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
  }

  .predictive-search-product-card:hover .predictive-search-product-card__title {
    color: #d8232a !important;
  }

  .predictive-search-product-card__price-col {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    gap: 2px !important;
    text-align: right !important;
  }

  .predictive-search-product-card__price {
    font-size: 0.94rem !important;
    font-weight: 800 !important;
    color: #d8232a !important;
    white-space: nowrap !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  .predictive-search-product-card__compare-price {
    font-size: 0.8rem !important;
    text-decoration: line-through !important;
    color: #94a3b8 !important;
    font-weight: 500 !important;
    white-space: nowrap !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  @media screen and (max-width: 480px) {
    .predictive-search-product-card {
      padding: 10px 12px !important;
      gap: 10px !important;
      border-radius: 14px !important;
      margin-bottom: 10px !important;
    }
    .predictive-search-product-card__left {
      gap: 10px !important;
    }
    .predictive-search-product-card__image-wrapper {
      width: 52px !important;
      height: 52px !important;
      min-width: 52px !important;
      border-radius: 10px !important;
    }
    .predictive-search-product-card__title {
      font-size: 0.85rem !important;
    }
    .predictive-search-product-card__price {
      font-size: 0.88rem !important;
    }
    .predictive-search-product-card__compare-price {
      font-size: 0.75rem !important;
    }
  }
</style>

<a href="{{ product.url }}" class="predictive-search-product-card">
  <div class="predictive-search-product-card__left">
    <div class="predictive-search-product-card__image-wrapper">
      {% if featured_img != blank %}
        <img
          src="{{ featured_img | image_url: width: 180 }}"
          alt="{{ product.title | escape }}"
          class="predictive-search-product-card__image"
          loading="lazy"
          width="60"
          height="60"
        >
      {% else %}
        <div class="predictive-search-product-card__placeholder">📦</div>
      {% endif %}
    </div>

    <div class="predictive-search-product-card__content">
      <span class="predictive-search-product-card__title">{{ product.title }}</span>
    </div>
  </div>

  <div class="predictive-search-product-card__price-col">
    <span class="predictive-search-product-card__price">{{ price | money }}</span>
    {% if compare_price > price %}
      <span class="predictive-search-product-card__compare-price">{{ compare_price | money }}</span>
    {% endif %}
  </div>
</a>
