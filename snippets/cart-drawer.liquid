{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              {% liquid
                assign free_shipping_threshold = 200000
                assign current_total = cart.total_price
                assign remaining_amount = free_shipping_threshold | minus: current_total
                assign progress_percent = current_total | times: 100 | divided_by: free_shipping_threshold
                if progress_percent > 100
                  assign progress_percent = 100
                endif

                assign total_compare_price = 0
                for item in cart.items
                  if item.variant.compare_at_price > item.variant.price
                    assign item_comp = item.variant.compare_at_price | times: item.quantity
                    assign total_compare_price = total_compare_price | plus: item_comp
                  else
                    assign item_orig = item.original_line_price
                    assign total_compare_price = total_compare_price | plus: item_orig
                  endif
                endfor

                assign total_savings = 0
                if total_compare_price > cart.total_price
                  assign total_savings = total_compare_price | minus: cart.total_price
                endif
              %}

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                {% comment %} --- Savings Banner --- {% endcomment %}
                {% if total_savings > 0 %}
                  <div class="boat-cart-savings-banner">
                    <span class="boat-savings-icon">🔥</span>
                    <span class="boat-savings-text">Total Savings on this order: <strong>{{ total_savings | money_without_trailing_zeros }}</strong></span>
                  </div>
                {% endif %}

                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section', total_savings: total_savings, total_compare_price: total_compare_price %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: 16px;
    --font-paragraph--line-height: 1;
    display: contents;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #f8fafc !important;
  }

  .theme-drawer__header {
    padding: 14px 18px !important;
    border-bottom: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
  }

  .theme-drawer__title {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.3px !important;
  }

  .theme-drawer__badge {
    background: #d8232a !important;
    color: #ffffff !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    padding: 2px 7px !important;
    border-radius: 12px !important;
    margin-left: 6px !important;
  }

  .theme-drawer__close-button {
    background: #f1f5f9 !important;
    border-radius: 50% !important;
    width: 32px !important;
    height: 32px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid #e2e8f0 !important;
    cursor: pointer !important;
    transition: background 0.15s ease !important;
  }

  .theme-drawer__close-button:hover {
    background: #e2e8f0 !important;
  }

  .boat-cart-shipping-bar {
    background: #ecfdf5 !important;
    border-bottom: 1px solid #a7f3d0 !important;
    padding: 10px 14px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .boat-cart-shipping-text {
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    color: #065f46 !important;
    text-align: center !important;
    line-height: 1.3 !important;
  }

  .boat-cart-shipping-text.unlocked {
    color: #047857 !important;
  }

  .boat-cart-progress-track {
    width: 100% !important;
    height: 7px !important;
    background: #d1fae5 !important;
    border-radius: 10px !important;
    overflow: hidden !important;
  }

  .boat-cart-progress-fill {
    height: 100% !important;
    background: #10b981 !important;
    border-radius: 10px !important;
    transition: width 0.4s ease !important;
  }

  .boat-cart-progress-fill.unlocked {
    background: linear-gradient(90deg, #10b981, #059669) !important;
  }

  .boat-cart-savings-banner {
    background: #fefce8 !important;
    border-bottom: 1px solid #fef08a !important;
    padding: 8px 14px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-size: 0.76rem !important;
    font-weight: 700 !important;
    color: #854d0e !important;
  }

  /* --- Collapsible Bill Breakdown Card (SS 3) --- */
  .boat-bill-card {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    padding: 10px 14px 10px 14px !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    margin-top: 4px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    transition: all 0.25s ease !important;
  }

  .boat-bill-collapse-body {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    overflow: hidden !important;
    transition: max-height 0.35s ease, opacity 0.25s ease, margin 0.25s ease !important;
    max-height: 250px !important;
    opacity: 1 !important;
  }

  .boat-bill-collapse-body.collapsed {
    max-height: 0 !important;
    opacity: 0 !important;
    margin: 0 !important;
    pointer-events: none !important;
  }

  .boat-bill-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    font-size: 0.84rem !important;
    font-weight: 700 !important;
    color: #1e293b !important;
    line-height: 1.3 !important;
  }

  .boat-bill-label {
    color: #334155 !important;
    font-weight: 700 !important;
  }

  .boat-bill-value {
    color: #0f172a !important;
    font-weight: 800 !important;
  }

  .boat-bill-value.text-green {
    color: #16a34a !important;
    font-weight: 800 !important;
  }

  .boat-bill-dashed-divider {
    border-bottom: 1px dashed #cbd5e1 !important;
    margin: 6px 0 4px 0 !important;
    width: 100% !important;
  }

  .boat-bill-main-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding-top: 4px !important;
    cursor: pointer !important;
    user-select: none !important;
  }

  .boat-bill-to-pay-left {
    display: flex !important;
    align-items: baseline !important;
    gap: 8px !important;
  }

  .boat-to-pay-label {
    font-size: 0.95rem !important;
    font-weight: 900 !important;
    color: #0f172a !important;
  }

  .boat-to-pay-value {
    font-size: 1.12rem !important;
    font-weight: 900 !important;
    color: #0f172a !important;
  }

  .boat-bill-toggle-btn {
    background: #f1f5f9 !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 50% !important;
    width: 26px !important;
    height: 26px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    padding: 0 !important;
    color: #0f172a !important;
    transition: background 0.15s ease, transform 0.25s ease !important;
  }

  .boat-bill-toggle-btn:hover {
    background: #e2e8f0 !important;
  }

  .boat-bill-arrow {
    transition: transform 0.25s ease !important;
    transform: rotate(0deg);
  }

  .boat-bill-toggle-btn.collapsed .boat-bill-arrow,
  .boat-bill-collapse-body.collapsed ~ .boat-bill-main-row .boat-bill-arrow {
    transform: rotate(180deg) !important;
  }

  .cart-drawer__content {
    height: calc(100% - 60px);
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: #f8fafc !important;
    flex-grow: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding: 12px 12px !important;
    overflow-y: auto;
    gap: 8px !important;
  }

  .cart-items__table {
    display: block !important;
    width: 100% !important;
    border-collapse: collapse !important;
  }

  .cart-items__table tbody {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    width: 100% !important;
  }

  .cart-items__table-row {
    display: flex !important;
    align-items: flex-start !important;
    gap: 10px !important;
    padding: 10px !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03) !important;
    position: relative !important;
  }

  .cart-items__media {
    width: 64px !important;
    height: 64px !important;
    min-width: 64px !important;
    min-height: 64px !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    border: 1px solid #e2e8f0 !important;
    background: #f1f5f9 !important;
    padding: 0 !important;
  }

  .cart-items__media-container {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .cart-items__media-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 8px !important;
  }

  .cart-items__details {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    padding: 0 !important;
    min-width: 0 !important;
  }

  .cart-items__title {
    font-size: 0.84rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    line-height: 1.25 !important;
    text-decoration: none !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .cart-items__variants {
    font-size: 0.72rem !important;
    color: #64748b !important;
    font-weight: 700 !important;
    margin: 0 !important;
    display: flex !important;
    gap: 4px !important;
  }

  .cart-items__quantity {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-top: 4px !important;
    padding: 0 !important;
  }

  .cart-quantity-selector {
    display: inline-flex !important;
    align-items: center !important;
    background: #f8fafc !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 16px !important;
    height: 26px !important;
    padding: 0 3px !important;
    box-sizing: border-box !important;
  }

  .cart-quantity-selector button {
    width: 20px !important;
    height: 20px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-weight: 800 !important;
    font-size: 0.8rem !important;
    color: #0f172a !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    padding: 0 !important;
  }

  .cart-quantity-selector button:hover {
    background: #e2e8f0 !important;
  }

  .cart-quantity-selector input {
    width: 24px !important;
    text-align: center !important;
    font-weight: 800 !important;
    font-size: 0.8rem !important;
    border: none !important;
    background: transparent !important;
    padding: 0 !important;
  }

  .cart-items__remove {
    color: #ef4444 !important;
    background: #fef2f2 !important;
    border: 1px solid #fee2e2 !important;
    width: 26px !important;
    height: 26px !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: background 0.15s ease !important;
    padding: 0 !important;
  }

  .cart-items__remove:hover {
    background: #fee2e2 !important;
  }

  .cart-drawer__summary {
    position: sticky !important;
    bottom: 0 !important;
    z-index: 10 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    padding: 12px 14px 14px 14px !important;
    margin-top: auto !important;
    background: #ffffff !important;
    border-top: 1px solid #e2e8f0 !important;
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.06) !important;
    mask-image: none !important;
  }

  .cart-totals {
    width: 100% !important;
  }

  .cart__checkout-button {
    background: #00b853 !important;
    color: #ffffff !important;
    font-size: 0.95rem !important;
    font-weight: 900 !important;
    letter-spacing: 0.3px !important;
    height: 46px !important;
    border-radius: 24px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    width: 100% !important;
    box-shadow: 0 4px 14px rgba(0, 184, 83, 0.35) !important;
    transition: transform 0.15s ease, background 0.15s ease !important;
    border: none !important;
    cursor: pointer !important;
    text-transform: uppercase !important;
  }

  .cart__checkout-button:hover {
    background: #009844 !important;
    transform: scale(1.01) !important;
  }

  .boat-cart-trust-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-around !important;
    padding: 8px 0 2px 0 !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #64748b !important;
    border-top: 1px dashed #e2e8f0 !important;
    margin-top: 4px !important;
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    padding: 40px 20px !important;
  }
{% endstylesheet %}
