<style>
  /* ==========================================================================
     App-Style Mobile Bottom Navigation Dock (Matching Reference Screenshot)
     ========================================================================== */
  .db-mobile-dock {
    display: none;
  }

  @media screen and (max-width: 768px) {
    body {
      padding-bottom: 74px !important;
    }

    .db-mobile-dock {
      display: flex !important;
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 62px !important;
      background: #ffffff !important;
      border-top: 1px solid rgba(0, 0, 0, 0.07) !important;
      border-radius: 20px 20px 0 0 !important;
      box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.08) !important;
      z-index: 999990 !important;
      align-items: center !important;
      justify-content: space-around !important;
      padding: 0 8px calc(env(safe-area-inset-bottom, 0px) / 2) 8px !important;
      box-sizing: border-box !important;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }

    .db-dock-item {
      flex: 1 1 0 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-decoration: none !important;
      color: #64748b !important;
      font-size: 0.68rem !important;
      font-weight: 600 !important;
      gap: 3px !important;
      position: relative !important;
      transition: color 0.2s ease, transform 0.15s ease !important;
      -webkit-tap-highlight-color: transparent !important;
      padding: 4px 0 !important;
    }

    .db-dock-item.active,
    .db-dock-item:hover {
      color: #00b853 !important;
    }

    .db-dock-icon-wrap {
      position: relative !important;
      width: 24px !important;
      height: 24px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .db-dock-icon {
      width: 22px !important;
      height: 22px !important;
      stroke-width: 2 !important;
      transition: transform 0.2s ease !important;
    }

    .db-dock-item.active .db-dock-icon {
      transform: scale(1.1) !important;
    }

    .db-dock-label {
      font-size: 0.68rem !important;
      font-weight: 600 !important;
      line-height: 1 !important;
      letter-spacing: 0.1px !important;
    }

    /* --- Center Elevated Floating Bubble Button --- */
    .db-dock-center-wrapper {
      position: relative !important;
      flex: 1 1 0 !important;
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      height: 100% !important;
    }

    .db-dock-center-btn {
      position: absolute !important;
      top: -24px !important;
      width: 54px !important;
      height: 54px !important;
      border-radius: 50% !important;
      background: #00b853 !important;
      border: 4.5px solid #ffffff !important;
      color: #ffffff !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 6px 18px rgba(0, 184, 83, 0.45) !important;
      text-decoration: none !important;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease !important;
      -webkit-tap-highlight-color: transparent !important;
    }

    .db-dock-center-btn:active {
      transform: scale(0.92) !important;
    }

    .db-dock-center-icon {
      width: 26px !important;
      height: 26px !important;
      stroke-width: 2.2 !important;
      color: #ffffff !important;
    }

    /* Notch cutout aura on bar behind center button */
    .db-dock-notch-aura {
      position: absolute;
      top: -16px;
      width: 66px;
      height: 33px;
      background: #ffffff;
      border-radius: 33px 33px 0 0;
      z-index: -1;
      box-shadow: 0 -3px 10px rgba(0,0,0,0.03);
    }
  }
</style>

{% liquid
  assign current_path = request.path
%}

<nav class="db-mobile-dock" id="DbMobileDock" aria-label="Mobile Bottom Navigation">
  {% comment %} 1. Home Tab {% endcomment %}
  <a href="/" class="db-dock-item {% if current_path == '/' or current_path == '' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if current_path == '/' or current_path == '' %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
    </div>
    <span class="db-dock-label">Home</span>
  </a>

  {% comment %} 2. Explore / Categories Tab {% endcomment %}
  <a href="/collections/all" class="db-dock-item {% if current_path contains '/collections' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
      </svg>
    </div>
    <span class="db-dock-label">Explore</span>
  </a>

  {% comment %} 3. Center Elevated Floating Bubble {% endcomment %}
  <div class="db-dock-center-wrapper">
    <div class="db-dock-notch-aura"></div>
    <a 
      href="https://wa.me/923102492119" 
      class="db-dock-center-btn"
      aria-label="Hot Deals"
      target="_blank"
    >
      {% comment %} Deal / Special Lightning Icon {% endcomment %}
      <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
    </a>
  </div>

  {% comment %} 4. Track Order Tab {% endcomment %}
  <a href="/pages/track-order" class="db-dock-item {% if current_path contains '/pages/track-order' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="1"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <span class="db-dock-label">Track</span>
  </a>

  {% comment %} 5. Profile / Support Tab {% endcomment %}
  <a href="/pages/shipping-returns" class="db-dock-item {% if current_path contains '/pages/shipping-returns' or current_path contains '/pages/contact' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </div>
    <span class="db-dock-label">Profile</span>
  </a>
</nav>
