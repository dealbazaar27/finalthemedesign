{% liquid
  assign enable_dock = settings.enable_mobile_bottom_nav
  if enable_dock == nil
    assign enable_dock = true
  endif

  # Global Dock Color Settings
  assign dock_bg = settings.dock_bg_color | default: '#ffffff'
  assign dock_active_color = settings.dock_active_color | default: '#00b853'
  assign dock_inactive_color = settings.dock_inactive_color | default: '#64748b'
  assign center_gradient_start = settings.dock_center_bg_1 | default: '#00b853'
  assign center_gradient_end = settings.dock_center_bg_2 | default: '#059669'

  assign show_center_bubble = settings.dock_show_center_bubble
  if show_center_bubble == nil
    assign show_center_bubble = true
  endif

  assign center_label = settings.dock_center_label | default: 'Sale'
  assign center_link = settings.dock_center_link | default: '/collections/all'
  assign center_icon = settings.dock_center_icon | default: 'bolt'

  assign whatsapp_num = settings.dock_whatsapp_number | default: '923102492119' | remove: '+' | remove: '-' | remove: ' '

  assign menu = linklists[settings.mobile_bottom_menu]
  assign current_path = request.path
%}

{% if enable_dock %}
  <style>
    /* ==========================================================================
       Global App-Like Dynamic Mobile Bottom Navigation Bar
       ========================================================================== */
    .db-mobile-dock {
      display: none;
    }

    @media screen and (max-width: 768px) {
      body {
        padding-bottom: 72px !important;
      }

      .db-mobile-dock {
        display: flex !important;
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        height: 62px !important;
        background: {{ dock_bg }} !important;
        border-top: 1px solid rgba(0, 0, 0, 0.07) !important;
        border-radius: 18px 18px 0 0 !important;
        box-shadow: 0 -4px 22px rgba(0, 0, 0, 0.08) !important;
        z-index: 999990 !important;
        align-items: center !important;
        justify-content: space-around !important;
        padding: 0 4px calc(env(safe-area-inset-bottom, 0px) / 2) 4px !important;
        box-sizing: border-box !important;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
      }

      .db-dock-item {
        flex: 1 1 0 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-decoration: none !important;
        color: {{ dock_inactive_color }} !important;
        font-size: 0.68rem !important;
        font-weight: 600 !important;
        gap: 3px !important;
        position: relative !important;
        transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s ease !important;
        -webkit-tap-highlight-color: transparent !important;
        padding: 4px 0 !important;
        background: transparent !important;
        border: none !important;
        cursor: pointer !important;
      }

      .db-dock-item.active,
      .db-dock-item:hover {
        color: {{ dock_active_color }} !important;
      }

      .db-dock-icon-wrap {
        position: relative !important;
        width: 24px !important;
        height: 24px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }

      .db-dock-icon {
        width: 21px !important;
        height: 21px !important;
        stroke-width: 2 !important;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
      }

      .db-dock-item.active .db-dock-icon {
        transform: scale(1.12) !important;
      }

      .db-dock-label {
        font-size: 0.67rem !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        letter-spacing: 0.1px !important;
        white-space: nowrap !important;
      }

      /* --- Center Floating Elevated Bubble Button --- */
      .db-dock-center-wrapper {
        position: relative !important;
        flex: 1 1 0 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-end !important;
        align-items: center !important;
        height: 100% !important;
        padding-bottom: 5px !important;
      }

      .db-dock-center-btn {
        position: absolute !important;
        top: -18px !important;
        width: 48px !important;
        height: 48px !important;
        border-radius: 50% !important;
        background: linear-gradient(135deg, {{ center_gradient_start }}, {{ center_gradient_end }}) !important;
        border: 3.5px solid {{ dock_bg }} !important;
        color: #ffffff !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-shadow: 0 5px 16px rgba(0, 184, 83, 0.4) !important;
        text-decoration: none !important;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease !important;
        -webkit-tap-highlight-color: transparent !important;
        z-index: 2 !important;
      }

      .db-dock-center-btn:active {
        transform: scale(0.92) !important;
      }

      .db-dock-center-icon {
        width: 22px !important;
        height: 22px !important;
        stroke-width: 2.2 !important;
        color: #ffffff !important;
      }

      .db-dock-center-label {
        font-size: 0.67rem !important;
        font-weight: 700 !important;
        color: {{ center_gradient_start }} !important;
        line-height: 1 !important;
        letter-spacing: 0.2px !important;
        margin-top: auto !important;
        z-index: 3 !important;
        white-space: nowrap !important;
      }

      .db-dock-notch-aura {
        position: absolute;
        top: -13px;
        width: 58px;
        height: 29px;
        background: {{ dock_bg }};
        border-radius: 29px 29px 0 0;
        z-index: 1;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.02);
      }

      /* Live Cart badge indicator */
      .db-dock-badge {
        position: absolute !important;
        top: -4px !important;
        right: -8px !important;
        background: #ef4444 !important;
        color: #ffffff !important;
        font-size: 0.62rem !important;
        font-weight: 800 !important;
        min-width: 16px !important;
        height: 16px !important;
        border-radius: 10px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 4px !important;
        border: 1.5px solid #ffffff !important;
        line-height: 1 !important;
        box-sizing: border-box !important;
        box-shadow: 0 2px 5px rgba(239, 68, 68, 0.4) !important;
      }

      .db-dock-whatsapp-icon {
        color: #25d366 !important;
      }
    }
  </style>

  <nav class="db-mobile-dock" id="DbMobileDock" aria-label="Mobile Navigation Dock">
    {% if menu != blank and menu.links.size > 0 %}
      {% comment %} ===== 1. DYNAMIC SHOPIFY MENU MODE ===== {% endcomment %}
      {% for link in menu.links %}
        {% assign l_title_down = link.title | downcase %}
        {% assign l_url_down = link.url | downcase %}
        
        {% assign is_active = false %}
        {% if current_path == link.url or current_path == link.url | append: '/' %}
          {% assign is_active = true %}
        {% elsif link.url != '/' and current_path contains link.url %}
          {% assign is_active = true %}
        {% endif %}

        {% if l_url_down contains '/cart' or l_title_down contains 'cart' %}
          <button 
            type="button"
            class="db-dock-item {% if current_path == '/cart' %}active{% endif %}"
            onclick="openMobileCartDrawer(event)"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="db-dock-badge" id="DbDockCartBadge" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
                {{ cart.item_count }}
              </span>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </button>

        {% elsif l_title_down contains 'categorie' or l_title_down contains 'menu' or l_title_down contains 'catalog' %}
          <a 
            href="{{ link.url }}" 
            class="db-dock-item {% if is_active %}active{% endif %}"
            onclick="openMobileCategories(event)"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if is_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </a>

        {% elsif l_url_down contains 'whatsapp' or l_url_down contains 'wa.me' or l_title_down contains 'whatsapp' or l_title_down contains 'chat' %}
          <a 
            href="https://wa.me/{{ whatsapp_num }}" 
            class="db-dock-item"
            target="_blank"
            rel="noopener"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon db-dock-whatsapp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </a>

        {% elsif l_url_down contains '/search' or l_title_down contains 'search' %}
          <button 
            type="button"
            class="db-dock-item {% if is_active %}active{% endif %}"
            onclick="openMobileSearchModal(event)"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </button>

        {% elsif l_url_down contains '/account' or l_title_down contains 'account' or l_title_down contains 'profile' %}
          <a 
            href="{{ link.url }}" 
            class="db-dock-item {% if is_active %}active{% endif %}"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </a>

        {% elsif l_title_down contains 'wishlist' or l_url_down contains 'wishlist' %}
          <a 
            href="{{ link.url }}" 
            class="db-dock-item {% if is_active %}active{% endif %}"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </a>

        {% else %}
          <a 
            href="{{ link.url }}" 
            class="db-dock-item {% if is_active %}active{% endif %}"
            aria-label="{{ link.title }}"
          >
            <div class="db-dock-icon-wrap">
              {% if link.url == '/' or l_title_down contains 'home' %}
                <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if is_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              {% else %}
                <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {% endif %}
            </div>
            <span class="db-dock-label">{{ link.title }}</span>
          </a>
        {% endif %}

      {% endfor %}

    {% else %}
      {% comment %} ===== 2. DEFAULT CLEAN GLOBAL 5-SLOT DOCK ===== {% endcomment %}
      
      {% comment %} 1. Home {% endcomment %}
      {% assign is_home_active = false %}
      {% if current_path == '/' or current_path == '' %}
        {% assign is_home_active = true %}
      {% endif %}
      <a href="/" class="db-dock-item {% if is_home_active %}active{% endif %}" aria-label="Home">
        <div class="db-dock-icon-wrap">
          <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if is_home_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <span class="db-dock-label">Home</span>
      </a>

      {% comment %} 2. Categories Drawer {% endcomment %}
      {% assign is_cat_active = false %}
      {% if current_path contains '/collections' and current_path != '/collections/all' %}
        {% assign is_cat_active = true %}
      {% endif %}
      <a 
        href="/collections" 
        class="db-dock-item {% if is_cat_active %}active{% endif %}"
        onclick="openMobileCategories(event)"
        aria-label="Categories"
      >
        <div class="db-dock-icon-wrap">
          <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if is_cat_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
        </div>
        <span class="db-dock-label">Categories</span>
      </a>

      {% comment %} 3. Center Elevated Bubble (Sale / Deals) {% endcomment %}
      {% if show_center_bubble %}
        <div class="db-dock-center-wrapper">
          <div class="db-dock-notch-aura"></div>
          <a href="{{ center_link }}" class="db-dock-center-btn" aria-label="{{ center_label }}">
            {% case center_icon %}
              {% when 'flame' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
              {% when 'tag' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
              {% when 'gift' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 12 20 22 4 22 4 12"></polyline>
                  <rect x="2" y="7" width="20" height="5"></rect>
                  <line x1="12" y1="22" x2="12" y2="7"></line>
                  <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                  <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                </svg>
              {% when 'cart' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              {% when 'whatsapp' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              {% when 'sparkle' %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z"></path>
                </svg>
              {% else %}
                <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            {% endcase %}
          </a>
          <span class="db-dock-center-label">{{ center_label }}</span>
        </div>
      {% endif %}

      {% comment %} 4. Cart Drawer {% endcomment %}
      <button 
        type="button"
        class="db-dock-item {% if current_path == '/cart' %}active{% endif %}"
        onclick="openMobileCartDrawer(event)"
        aria-label="Cart"
      >
        <div class="db-dock-icon-wrap">
          <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="db-dock-badge" id="DbDockCartBadge" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
            {{ cart.item_count }}
          </span>
        </div>
        <span class="db-dock-label">Cart</span>
      </button>

      {% comment %} 5. WhatsApp Chat {% endcomment %}
      <a 
        href="https://wa.me/{{ whatsapp_num }}" 
        class="db-dock-item"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
      >
        <div class="db-dock-icon-wrap">
          <svg class="db-dock-icon db-dock-whatsapp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <span class="db-dock-label">WhatsApp</span>
      </a>

    {% endif %}
  </nav>

  <script>
    function openMobileCategories(e) {
      const menuContainer = document.getElementById('Details-menu-drawer-container') || document.querySelector('header-drawer details');
      if (menuContainer) {
        if (e) e.preventDefault();
        const summary = menuContainer.querySelector('summary');
        if (summary) {
          summary.click();
          return;
        }
        menuContainer.setAttribute('open', '');
        return;
      }
    }

    function openMobileSearchModal(e) {
      if (e) e.preventDefault();
      const modal = document.getElementById('search-modal') || document.querySelector('search-modal dialog');
      if (modal) {
        if (typeof modal.showModal === 'function') modal.showModal();
        modal.setAttribute('open', '');
        return;
      }
      window.location.href = '/search';
    }

    function openMobileCartDrawer(e) {
      if (e) e.preventDefault();
      const drawer = document.getElementById('cart-drawer');
      if (!drawer) {
        window.location.href = '/cart';
        return;
      }
      
      const dialog = drawer.querySelector('dialog') || (drawer.tagName === 'DIALOG' ? drawer : null);
      if (dialog && typeof dialog.showModal === 'function') {
        try { dialog.showModal(); } catch (err) {}
      }

      drawer.setAttribute('open', '');
      if (drawer.show) drawer.show();
      drawer.dispatchEvent(new CustomEvent('theme-drawer:open', { bubbles: true }));
    }

    // --- Real-Time Cart Count Synchronization Across All Pages ---
    (function() {
      function setDbCartBadgeCount(count) {
        const badge = document.getElementById('DbDockCartBadge');
        if (!badge) return;
        const num = parseInt(count, 10) || 0;
        badge.textContent = num;
        badge.style.display = num > 0 ? 'flex' : 'none';
      }

      function syncFromCartAPI() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            if (cart && typeof cart.item_count !== 'undefined') {
              setDbCartBadgeCount(cart.item_count);
            }
          })
          .catch(() => {});
      }

      const originalFetch = window.fetch;
      window.fetch = function() {
        const args = arguments;
        const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
        const promise = originalFetch.apply(this, args);

        if (url && (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/update') || url.includes('/cart/clear'))) {
          promise.then(response => {
            try {
              const clone = response.clone();
              clone.json().then(data => {
                if (data && typeof data.item_count !== 'undefined') {
                  setDbCartBadgeCount(data.item_count);
                } else {
                  syncFromCartAPI();
                }
              }).catch(() => syncFromCartAPI());
            } catch (err) {
              syncFromCartAPI();
            }
          });
        }
        return promise;
      };

      const cartEvents = ['cart:lines:update', 'cart:updated', 'cart:update', 'cart:change', 'ajaxCart.afterCartLoad', 'shopify:cart:lines-update'];
      cartEvents.forEach(evtName => {
        document.addEventListener(evtName, function(event) {
          if (event && event.detail && typeof event.detail.item_count !== 'undefined') {
            setDbCartBadgeCount(event.detail.item_count);
          } else if (event && event.detail && typeof event.detail.itemCount !== 'undefined') {
            setDbCartBadgeCount(event.detail.itemCount);
          } else if (event && event.detail && event.detail.cart && typeof event.detail.cart.item_count !== 'undefined') {
            setDbCartBadgeCount(event.detail.cart.item_count);
          } else {
            syncFromCartAPI();
          }
        });
      });

      function observeHeaderCart() {
        const headerBadges = document.querySelectorAll('[ref="cartBubbleCount"], .theme-drawer__badge, cart-icon');
        if (headerBadges.length > 0) {
          const observer = new MutationObserver(() => {
            headerBadges.forEach(el => {
              const val = parseInt(el.textContent.trim(), 10);
              if (!isNaN(val)) setDbCartBadgeCount(val);
            });
          });
          headerBadges.forEach(el => observer.observe(el, { childList: true, characterData: true, subtree: true }));
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          syncFromCartAPI();
          observeHeaderCart();
        });
      } else {
        syncFromCartAPI();
        observeHeaderCart();
      }

      window.addEventListener('pageshow', syncFromCartAPI);
      window.setDbMobileCartBadge = setDbCartBadgeCount;
    })();
  </script>
{% endif %}
