<style>
  /* ==========================================================================
     App-Style Mobile Bottom Navigation Dock (Home, Track, SALE, Cart, Profile)
     ========================================================================== */
  .db-mobile-dock {
    display: none;
  }

  @media screen and (max-width: 768px) {
    body {
      padding-bottom: 74px !important;
    }

    .db-mobile-dock {
      display: flex !important;
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 62px !important;
      background: #ffffff !important;
      border-top: 1px solid rgba(0, 0, 0, 0.07) !important;
      border-radius: 20px 20px 0 0 !important;
      box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.08) !important;
      z-index: 999990 !important;
      align-items: center !important;
      justify-content: space-around !important;
      padding: 0 6px calc(env(safe-area-inset-bottom, 0px) / 2) 6px !important;
      box-sizing: border-box !important;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }

    .db-dock-item {
      flex: 1 1 0 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-decoration: none !important;
      color: #64748b !important;
      font-size: 0.68rem !important;
      font-weight: 600 !important;
      gap: 3px !important;
      position: relative !important;
      transition: color 0.2s ease, transform 0.15s ease !important;
      -webkit-tap-highlight-color: transparent !important;
      padding: 4px 0 !important;
      background: transparent !important;
      border: none !important;
      cursor: pointer !important;
    }

    .db-dock-item.active,
    .db-dock-item:hover {
      color: #00b853 !important;
    }

    .db-dock-icon-wrap {
      position: relative !important;
      width: 24px !important;
      height: 24px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .db-dock-icon {
      width: 22px !important;
      height: 22px !important;
      stroke-width: 2 !important;
      transition: transform 0.2s ease !important;
    }

    .db-dock-item.active .db-dock-icon {
      transform: scale(1.1) !important;
    }

    .db-dock-label {
      font-size: 0.68rem !important;
      font-weight: 600 !important;
      line-height: 1 !important;
      letter-spacing: 0.1px !important;
    }

    /* --- Center Elevated Floating Bubble Button (SALE) --- */
    .db-dock-center-wrapper {
      position: relative !important;
      flex: 1 1 0 !important;
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      height: 100% !important;
    }

    .db-dock-center-btn {
      position: absolute !important;
      top: -24px !important;
      width: 54px !important;
      height: 54px !important;
      border-radius: 50% !important;
      background: linear-gradient(135deg, #00b853, #059669) !important;
      border: 4.5px solid #ffffff !important;
      color: #ffffff !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 6px 18px rgba(0, 184, 83, 0.45) !important;
      text-decoration: none !important;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease !important;
      -webkit-tap-highlight-color: transparent !important;
    }

    .db-dock-center-btn:active {
      transform: scale(0.92) !important;
    }

    .db-dock-center-icon {
      width: 24px !important;
      height: 24px !important;
      stroke-width: 2.2 !important;
      color: #ffffff !important;
    }

    /* Notch cutout aura on bar behind center button */
    .db-dock-notch-aura {
      position: absolute;
      top: -16px;
      width: 66px;
      height: 33px;
      background: #ffffff;
      border-radius: 33px 33px 0 0;
      z-index: -1;
      box-shadow: 0 -3px 10px rgba(0,0,0,0.03);
    }

    /* Cart badge indicator on dock item */
    .db-dock-badge {
      position: absolute !important;
      top: -4px !important;
      right: -8px !important;
      background: #ef4444 !important;
      color: #ffffff !important;
      font-size: 0.62rem !important;
      font-weight: 800 !important;
      min-width: 16px !important;
      height: 16px !important;
      border-radius: 10px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 4px !important;
      border: 1.5px solid #ffffff !important;
      line-height: 1 !important;
      box-sizing: border-box !important;
    }
  }
</style>

{% liquid
  assign current_path = request.path
%}

<nav class="db-mobile-dock" id="DbMobileDock" aria-label="Mobile Bottom Navigation">
  {% comment %} 1. Home Tab {% endcomment %}
  <a href="/" class="db-dock-item {% if current_path == '/' or current_path == '' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if current_path == '/' or current_path == '' %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
    </div>
    <span class="db-dock-label">Home</span>
  </a>

  {% comment %} 2. Track Order Tab {% endcomment %}
  <a href="/pages/track-order" class="db-dock-item {% if current_path contains '/pages/track-order' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="1"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <span class="db-dock-label">Track</span>
  </a>

  {% comment %} 3. Center Elevated Floating Bubble (SALE) {% endcomment %}
  <div class="db-dock-center-wrapper">
    <div class="db-dock-notch-aura"></div>
    <a 
      href="/collections/all" 
      class="db-dock-center-btn"
      aria-label="Hot Sale & Deals"
    >
      <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
    </a>
  </div>

  {% comment %} 4. Cart Tab (Opens Cart Drawer) {% endcomment %}
  <button 
    type="button"
    class="db-dock-item"
    aria-label="Shopping Cart"
    onclick="openMobileCartDrawer(event)"
  >
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span class="db-dock-badge" id="DbDockCartBadge" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
        {{ cart.item_count }}
      </span>
    </div>
    <span class="db-dock-label">Cart</span>
  </button>

  {% comment %} 5. Profile / Support Tab {% endcomment %}
  <a href="/pages/shipping-returns" class="db-dock-item {% if current_path contains '/pages/shipping-returns' or current_path contains '/pages/contact' %}active{% endif %}">
    <div class="db-dock-icon-wrap">
      <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </div>
    <span class="db-dock-label">Profile</span>
  </a>
</nav>

<script>
  function openMobileCartDrawer(e) {
    if (e) e.preventDefault();
    const drawer = document.getElementById('cart-drawer');
    if (!drawer) {
      window.location.href = '/cart';
      return;
    }
    
    // Method 1: native showModal if dialog
    const dialog = drawer.querySelector('dialog') || (drawer.tagName === 'DIALOG' ? drawer : null);
    if (dialog && typeof dialog.showModal === 'function') {
      try { dialog.showModal(); } catch (err) {}
    }

    // Method 2: theme-drawer open attribute
    drawer.setAttribute('open', '');
    if (drawer.show) drawer.show();

    // Method 3: dispatch custom event
    drawer.dispatchEvent(new CustomEvent('theme-drawer:open', { bubbles: true }));
  }

  // Live Cart Count sync for bottom dock badge
  document.addEventListener('cart:updated', function(event) {
    const badge = document.getElementById('DbDockCartBadge');
    if (badge && event.detail && typeof event.detail.item_count !== 'undefined') {
      const count = event.detail.item_count;
      badge.textContent = count;
      badge.style.display = count > 0 ? 'flex' : 'none';
    }
  });
</script>
