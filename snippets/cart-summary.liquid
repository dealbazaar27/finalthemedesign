{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}
{% render 'cart-typography-styles' %}

{% liquid
  if settings.currency_code_enabled_cart_total
    assign total_price = cart.total_price | money_with_currency
  else
    assign total_price = cart.total_price | money_without_trailing_zeros
  endif

  # Total discounts applied by Shopify (Automatic Discounts + Coupon Codes)
  assign total_cart_discount = cart.total_discount | default: 0

  # Calculate voucher / coupon discounts if any
  assign voucher_discount = 0
  for discount in cart.cart_level_discount_applications
    assign voucher_discount = voucher_discount | plus: discount.total_allocated_amount
  endfor
  for item in cart.items
    for allocation in item.line_level_discount_allocations
      assign voucher_discount = voucher_discount | plus: allocation.amount
    endfor
  endfor
  if voucher_discount == 0 and total_cart_discount > 0
    assign voucher_discount = total_cart_discount
  endif

  # Calculate MRP compare total if not passed from parent
  if total_compare_price == blank or total_compare_price == 0
    assign total_compare_price = 0
    for item in cart.items
      if item.variant.compare_at_price > item.variant.price
        assign item_comp = item.variant.compare_at_price | times: item.quantity
        assign total_compare_price = total_compare_price | plus: item_comp
      else
        assign item_orig = item.original_line_price
        assign total_compare_price = total_compare_price | plus: item_orig
      endif
    endfor
  endif

  # Special Discount (MRP Discount)
  assign mrp_discount = 0
  if total_compare_price > cart.items_subtotal_price
    assign mrp_discount = total_compare_price | minus: cart.items_subtotal_price
  endif
%}

<div class="cart-totals">
  {% comment %} Morphing container hidden placeholder {% endcomment %}
  <div class="cart-totals__original-container visually-hidden" aria-hidden="true" style="display:none;">
    <span class="cart-totals__original-value" data-testid="cart-subtotal-value">{{ cart.items_subtotal_price | money }}</span>
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script type="module" src="{{ 'cart-note.js' | asset_url }}"></script>
        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details {% if settings.cart_note_open_by_default %}open{% endif %}>
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">{{ 'content.seller_note' | t }}</span>
                <span class="cart-totals__icon">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </summary>
              <div class="details-content cart-note__inner">
                <textarea form="cart-form" on:input="/updateCartNote" id="cart-note" class="cart-note__instructions" name="note" data-skip-node-update>{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component', children: cart_note_accordion_children, class: 'cart-note' %}
        </cart-note>
      {% endif %}

      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor
          assign discount_codes = discount_codes | uniq
        %}

        {% capture cart_discount_accordion_children %}
          <details {% if discount_codes.size > 0 or cart.discount_applications.size > 0 %}open{% endif %}>
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">Discount / Voucher Code</span>
              <span class="cart-totals__icon">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component {% if section_id != blank %}data-section-id="{{ section_id }}"{% endif %}>
                  <div class="cart-discount__content">
                    <form class="cart-discount__form" onsubmit="window.handleManualDiscountApply(event, this); return false;">
                      <input id="cart-discount" class="cart-discount__input" type="text" name="discount" size="8" placeholder="Enter coupon code" required data-skip-node-update>
                      <button type="submit" class="button cart-discount__button">{{ 'actions.apply' | t }}</button>
                    </form>
                  </div>

                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      Invalid coupon code
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t | default: 'Discount not applicable for shipping' }}
                    </small>
                  </div>

                  <ul class="cart-discount__codes" id="BoatCartDiscountCodesList">
                    {% for app in cart.discount_applications %}
                      {% if app.type == 'automatic' %}
                        <li class="cart-discount__pill cart-discount__pill--auto" style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 6px 10px; margin-bottom: 6px;">
                          <p class="cart-discount__pill-code" style="color: #065f46; font-weight: 800; font-size: 0.8rem; margin: 0;">
                            ✨ Auto Applied: {{ app.title }} (-{{ app.total_allocated_amount | money_without_trailing_zeros }})
                          </p>
                        </li>
                      {% endif %}
                    {% endfor %}

                    {% for discount_code in discount_codes %}
                      <li class="cart-discount__pill" data-discount-code="{{ discount_code }}">
                        <p class="cart-discount__pill-code">🏷️ {{ discount_code }}</p>
                        <button type="button" onclick="window.handleManualDiscountRemove(event, '{{ discount_code }}')" class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled" aria-label="Remove {{ discount_code }}">
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {% endif %}
    </div>
  {% endif %}

  {% comment %} --- Dedicated Collapsible Bill Breakdown (SS 3) --- {% endcomment %}
  <div class="boat-bill-card" id="BoatBillCard">
    <div class="boat-bill-collapse-body collapsed" id="BoatBillCollapseBody">
      <div class="boat-bill-row">
        <span class="boat-bill-label">MRP Total:</span>
        <span class="boat-bill-value">{{ total_compare_price | money_without_trailing_zeros }}</span>
      </div>

      {% if mrp_discount > 0 %}
        <div class="boat-bill-row">
          <span class="boat-bill-label">MRP Discount:</span>
          <span class="boat-bill-value text-green">- {{ mrp_discount | money_without_trailing_zeros }}</span>
        </div>
      {% endif %}

      <div class="boat-bill-row">
        <span class="boat-bill-label">Cart Subtotal:</span>
        <span class="boat-bill-value">{{ cart.items_subtotal_price | money_without_trailing_zeros }}</span>
      </div>

      {% comment %} Show all applied Automatic Discounts & Coupon Codes {% endcomment %}
      {% if cart.discount_applications.size > 0 %}
        {% for discount in cart.discount_applications %}
          <div class="boat-bill-row">
            <span class="boat-bill-label">
              {% if discount.type == 'automatic' %}
                ✨ Auto Discount ({{ discount.title }}):
              {% else %}
                🏷️ Voucher ({{ discount.title }}):
              {% endif %}
            </span>
            <span class="boat-bill-value text-green">- {{ discount.total_allocated_amount | money_without_trailing_zeros }}</span>
          </div>
        {% endfor %}
      {% elsif voucher_discount > 0 %}
        <div class="boat-bill-row">
          <span class="boat-bill-label">Voucher Discount:</span>
          <span class="boat-bill-value text-green">- {{ voucher_discount | money_without_trailing_zeros }}</span>
        </div>
      {% endif %}

      <div class="boat-bill-row">
        <span class="boat-bill-label">Delivery Charges:</span>
        <span class="boat-bill-value" id="BoatDeliveryFeeValue" style="font-weight: 700; color: #0f172a;">
          Calculated at checkout
        </span>
      </div>

      <div class="boat-bill-dashed-divider"></div>
    </div>

    {% comment %} --- Main To Pay Row + Arrow Toggle --- {% endcomment %}
    <div class="boat-bill-main-row" onclick="toggleBoatBillBreakdown()">
      <div class="boat-bill-to-pay-left">
        <span class="boat-to-pay-label">To Pay:</span>
        <text-component
          ref="cartTotal"
          value="{{ total_price | strip_html }}"
          class="boat-to-pay-value"
          data-testid="cart-total-value"
          data-cart-subtotal
        >
          {{ total_price }}
        </text-component>
        <span class="boat-bill-view-tag">Check Bill Details</span>
      </div>

      <button type="button" class="boat-bill-toggle-btn collapsed" id="BoatBillToggleBtn" aria-label="Toggle bill breakdown">
        <svg class="boat-bill-arrow" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  if (typeof window.toggleBoatBillBreakdown !== 'function') {
    window.toggleBoatBillBreakdown = function() {
      const body = document.getElementById('BoatBillCollapseBody');
      const btn = document.getElementById('BoatBillToggleBtn');
      if (!body) return;
      if (body.classList.contains('collapsed')) {
        body.classList.remove('collapsed');
        if (btn) btn.classList.remove('collapsed');
      } else {
        body.classList.add('collapsed');
        if (btn) btn.classList.add('collapsed');
      }
    };
  }

  // Live Fetch Shopify Backend Shipping Rates
  (function() {
    function fetchBackendShippingRate() {
      const deliveryEl = document.getElementById('BoatDeliveryFeeValue');
      const toPayEl = document.querySelector('.boat-to-pay-value');
      if (!deliveryEl) return;

      const cartSubtotalCents = {{ cart.total_price }};
      const country = '{{ localization.country.name | default: "Pakistan" }}';
      const url = `/cart/shipping_rates.json?shipping_address%5Bcountry%5D=${encodeURIComponent(country)}`;

      fetch(url)
        .then(res => {
          if (!res.ok) throw new Error('Not available');
          return res.json();
        })
        .then(data => {
          if (data && data.shipping_rates && data.shipping_rates.length > 0) {
            const rate = data.shipping_rates[0];
            const shippingPrice = parseFloat(rate.price);

            if (shippingPrice === 0) {
              deliveryEl.innerHTML = '<span class="text-green" style="font-weight:800; color:#00b853;">FREE</span>';
            } else {
              const formattedPrice = 'Rs.' + Math.round(shippingPrice).toLocaleString();
              deliveryEl.innerHTML = '<span style="font-weight:700; color:#0f172a;">+ ' + formattedPrice + '</span>';

              if (toPayEl) {
                const subtotalNum = cartSubtotalCents / 100;
                const finalTotal = subtotalNum + shippingPrice;
                toPayEl.textContent = 'Rs.' + Math.round(finalTotal).toLocaleString();
              }
            }
          }
        })
        .catch(() => {
          // Gracefully keep 'Calculated at checkout'
          if (deliveryEl) deliveryEl.textContent = 'Calculated at checkout';
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fetchBackendShippingRate);
    } else {
      fetchBackendShippingRate();
    }
  })();

  // Auto-fetch & sync discounts from URL / Session / Product Deals
  (function initAutoDiscountSync() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const urlDiscount = urlParams.get('discount') || urlParams.get('coupon') || urlParams.get('code');
      if (urlDiscount) {
        sessionStorage.setItem('dealbazaar_auto_discount', urlDiscount.trim());
      }

      const activeCode = window.activePdpDiscountCode || sessionStorage.getItem('dealbazaar_auto_discount') || sessionStorage.getItem('dealbazaar_applied_coupon');
      if (activeCode) {
        const appliedPills = document.querySelectorAll('.cart-discount__pill[data-discount-code]');
        let isAlreadyApplied = false;
        appliedPills.forEach(pill => {
          if (pill.dataset.discountCode && pill.dataset.discountCode.toLowerCase() === activeCode.toLowerCase()) {
            isAlreadyApplied = true;
          }
        });

        const codesList = document.getElementById('BoatCartDiscountCodesList');
        if (codesList && !isAlreadyApplied && sessionStorage.getItem('dealbazaar_applied_coupon') === activeCode) {
          const pill = document.createElement('li');
          pill.className = 'cart-discount__pill';
          pill.setAttribute('data-discount-code', activeCode);
          pill.innerHTML = `
            <p class="cart-discount__pill-code">🏷️ ${activeCode}</p>
            <button type="button" onclick="window.handleManualDiscountRemove(event, '${activeCode}')" class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled" aria-label="Remove ${activeCode}">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          `;
          codesList.appendChild(pill);
        }

        const input = document.getElementById('cart-discount');
        if (input && !input.value && !isAlreadyApplied) {
          input.value = activeCode;
        }

        const cartItemCount = {{ cart.item_count | default: 0 }};
        if (!isAlreadyApplied && cartItemCount > 0 && window.lastAutoDiscountAttempt !== activeCode) {
          window.lastAutoDiscountAttempt = activeCode;
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              discount: activeCode,
              sections: ['cart-drawer-section']
            })
          })
          .then(res => res.json())
          .then(data => {
            if (data && data.sections && data.sections['cart-drawer-section']) {
              const liveSection = document.getElementById('shopify-section-cart-drawer-section');
              if (liveSection) {
                const parser = new DOMParser();
                const doc = parser.parseFromString(data.sections['cart-drawer-section'], 'text/html');
                const newSection = doc.getElementById('shopify-section-cart-drawer-section');
                if (newSection) {
                  const liveSummary = liveSection.querySelector('.cart-drawer__summary');
                  const newSummary = newSection.querySelector('.cart-drawer__summary');
                  if (liveSummary && newSummary) {
                    liveSummary.innerHTML = newSummary.innerHTML;
                  }
                }
              }
            }
          })
          .catch(e => console.warn('Auto discount sync error:', e));
        }
      }
    } catch(e) {}
  })();

  // Direct 100% Reliable Manual Discount Apply & Remove Handlers
  window.handleManualDiscountApply = async function(event, form) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    const input = form ? form.querySelector('input[name="discount"]') : document.getElementById('cart-discount');
    if (!input) return;
    const code = input.value.trim();
    if (!code) return;

    const btn = form ? form.querySelector('button[type="submit"]') : document.querySelector('.cart-discount__button');
    const origText = btn ? btn.innerHTML : 'Apply';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span style="font-size:12px;">Applying...</span>';
    }

    const errBox = document.querySelector('.cart-discount__error');
    const errText = document.querySelector('.cart-discount__error-text');
    if (errBox) errBox.classList.add('hidden');

    try {
      // 1. Store coupon in session
      sessionStorage.setItem('dealbazaar_applied_coupon', code);

      // 2. Set Shopify discount session
      try {
        await fetch('/discount/' + encodeURIComponent(code));
      } catch(e) {}

      // 3. Update cart via Shopify AJAX API
      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          discount: code,
          sections: ['cart-drawer-section']
        })
      });
      const data = await res.json();

      if (data.sections && data.sections['cart-drawer-section']) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(data.sections['cart-drawer-section'], 'text/html');
        const newSection = doc.getElementById('shopify-section-cart-drawer-section');
        const liveSection = document.getElementById('shopify-section-cart-drawer-section');

        if (newSection && liveSection) {
          const liveItems = liveSection.querySelector('.cart-drawer__items');
          const liveItemsNew = newSection.querySelector('.cart-drawer__items');
          if (liveItems && liveItemsNew) liveItems.innerHTML = liveItemsNew.innerHTML;

          const liveSummary = liveSection.querySelector('.cart-drawer__summary');
          const liveSummaryNew = newSection.querySelector('.cart-drawer__summary');
          if (liveSummary && liveSummaryNew) liveSummary.innerHTML = liveSummaryNew.innerHTML;
        }
      }

      // Ensure discount pill is visible
      const codesList = document.getElementById('BoatCartDiscountCodesList');
      if (codesList && !codesList.querySelector(`[data-discount-code="${code}"]`)) {
        const pill = document.createElement('li');
        pill.className = 'cart-discount__pill';
        pill.setAttribute('data-discount-code', code);
        pill.innerHTML = `
          <p class="cart-discount__pill-code">🏷️ ${code}</p>
          <button type="button" onclick="window.handleManualDiscountRemove(event, '${code}')" class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled" aria-label="Remove ${code}">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        `;
        codesList.appendChild(pill);
      }

      // Open bill breakdown
      const collapseBody = document.getElementById('BoatBillCollapseBody');
      const arrowBtn = document.getElementById('BoatBillToggleBtn');
      if (collapseBody) collapseBody.classList.remove('collapsed');
      if (arrowBtn) arrowBtn.classList.remove('collapsed');

      if (typeof window.fetchBackendShippingRate === 'function') {
        window.fetchBackendShippingRate();
      }

      input.value = '';
    } catch (err) {
      console.warn('Discount apply error:', err);
      if (errBox) {
        errBox.classList.remove('hidden');
        if (errText) {
          errText.classList.remove('hidden');
          errText.textContent = 'Could not apply coupon. Please check code.';
        }
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }
  };

  window.handleBoatCheckoutRedirect = function(event) {
    const coupon = sessionStorage.getItem('dealbazaar_applied_coupon');
    if (coupon) {
      if (event) event.preventDefault();
      window.location.href = '/checkout?discount=' + encodeURIComponent(coupon);
    }
  };

  window.handleManualDiscountRemove = async function(event, code) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    sessionStorage.removeItem('dealbazaar_applied_coupon');

    try {
      await fetch('/discount/');
      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          discount: '',
          sections: ['cart-drawer-section']
        })
      });
      const data = await res.json();
      if (data.sections && data.sections['cart-drawer-section']) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(data.sections['cart-drawer-section'], 'text/html');
        const newSection = doc.getElementById('shopify-section-cart-drawer-section');
        const liveSection = document.getElementById('shopify-section-cart-drawer-section');

        if (newSection && liveSection) {
          const liveItems = liveSection.querySelector('.cart-drawer__items');
          const newItems = newSection.querySelector('.cart-drawer__items');
          if (liveItems && newItems) liveItems.innerHTML = newItems.innerHTML;

          const liveSummary = liveSection.querySelector('.cart-drawer__summary');
          const newSummary = newSection.querySelector('.cart-drawer__summary');
          if (liveSummary && newSummary) liveSummary.innerHTML = newSummary.innerHTML;
        }
      }
    } catch(e) {
      console.warn('Discount remove error:', e);
    }
  };
</script>

<div class="cart__ctas" style="width: 100%;">
  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
    onclick="window.handleBoatCheckoutRedirect(event)"
  >
    <span class="button-text">
      PROCEED TO CHECKOUT ➔
    </span>
  </button>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }
{% endstylesheet %}
