{% liquid
  assign enable_bottom_nav = section.settings.enable_bottom_nav
%}

{% if enable_bottom_nav %}
  <style>
    /* ==========================================================================
       App-Style Mobile Bottom Navigation Dock (SS Matching Design)
       ========================================================================== */
    .db-mobile-dock {
      display: none;
    }

    @media screen and (max-width: 768px) {
      body {
        padding-bottom: 74px !important;
      }

      .db-mobile-dock {
        display: flex !important;
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        height: 62px !important;
        background: {{ section.settings.bg_color | default: '#ffffff' }} !important;
        border-top: 1px solid rgba(0, 0, 0, 0.06) !important;
        border-radius: 20px 20px 0 0 !important;
        box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.08) !important;
        z-index: 999990 !important;
        align-items: center !important;
        justify-content: space-around !important;
        padding: 0 8px calc(env(safe-area-inset-bottom, 0px) / 2) 8px !important;
        box-sizing: border-box !important;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }

      .db-dock-item {
        flex: 1 1 0 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-decoration: none !important;
        color: {{ section.settings.inactive_color | default: '#64748b' }} !important;
        font-size: 0.68rem !important;
        font-weight: 600 !important;
        gap: 3px !important;
        position: relative !important;
        transition: color 0.2s ease, transform 0.15s ease !important;
        -webkit-tap-highlight-color: transparent !important;
        padding: 4px 0 !important;
      }

      .db-dock-item.active,
      .db-dock-item:hover {
        color: {{ section.settings.active_color | default: '#00b853' }} !important;
      }

      .db-dock-icon-wrap {
        position: relative !important;
        width: 24px !important;
        height: 24px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }

      .db-dock-icon {
        width: 22px !important;
        height: 22px !important;
        stroke-width: 2 !important;
        transition: transform 0.2s ease !important;
      }

      .db-dock-item.active .db-dock-icon {
        transform: scale(1.1) !important;
      }

      .db-dock-label {
        font-size: 0.68rem !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        letter-spacing: 0.1px !important;
      }

      /* --- Center Elevated Floating Bubble Button --- */
      .db-dock-center-wrapper {
        position: relative !important;
        flex: 1 1 0 !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        height: 100% !important;
      }

      .db-dock-center-btn {
        position: absolute !important;
        top: -24px !important;
        width: 54px !important;
        height: 54px !important;
        border-radius: 50% !important;
        background: {{ section.settings.center_btn_bg | default: '#00b853' }} !important;
        border: 4.5px solid #ffffff !important;
        color: #ffffff !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-shadow: 0 6px 18px rgba(0, 184, 83, 0.45) !important;
        text-decoration: none !important;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease !important;
        -webkit-tap-highlight-color: transparent !important;
      }

      .db-dock-center-btn:active {
        transform: scale(0.92) !important;
      }

      .db-dock-center-icon {
        width: 26px !important;
        height: 26px !important;
        stroke-width: 2.2 !important;
        color: #ffffff !important;
      }

      /* Notch cutout aura on bar behind center button */
      .db-dock-notch-aura {
        position: absolute;
        top: -16px;
        width: 66px;
        height: 33px;
        background: {{ section.settings.bg_color | default: '#ffffff' }};
        border-radius: 33px 33px 0 0;
        z-index: -1;
        box-shadow: 0 -3px 10px rgba(0,0,0,0.03);
      }

      /* Cart badge indicator on dock item */
      .db-dock-badge {
        position: absolute !important;
        top: -3px !important;
        right: -6px !important;
        background: #ef4444 !important;
        color: #ffffff !important;
        font-size: 0.62rem !important;
        font-weight: 800 !important;
        min-width: 16px !important;
        height: 16px !important;
        border-radius: 10px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 4px !important;
        border: 1.5px solid #ffffff !important;
      }
    }
  </style>

  {% liquid
    assign current_path = request.path
  %}

  <nav class="db-mobile-dock" id="DbMobileDock" aria-label="Mobile Bottom Navigation">
    {% comment %} 1. Home Tab {% endcomment %}
    <a href="{{ section.settings.tab1_link | default: '/' }}" class="db-dock-item {% if current_path == '/' or current_path == '' %}active{% endif %}">
      <div class="db-dock-icon-wrap">
        <svg class="db-dock-icon" viewBox="0 0 24 24" fill="{% if current_path == '/' or current_path == '' %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </div>
      <span class="db-dock-label">{{ section.settings.tab1_label | default: 'Home' }}</span>
    </a>

    {% comment %} 2. Explore / Categories Tab {% endcomment %}
    <a href="{{ section.settings.tab2_link | default: '/collections/all' }}" class="db-dock-item {% if current_path contains '/collections' %}active{% endif %}">
      <div class="db-dock-icon-wrap">
        <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
      </div>
      <span class="db-dock-label">{{ section.settings.tab2_label | default: 'Explore' }}</span>
    </a>

    {% comment %} 3. Center Elevated Floating Bubble {% endcomment %}
    <div class="db-dock-center-wrapper">
      <div class="db-dock-notch-aura"></div>
      <a 
        href="{{ section.settings.center_link | default: 'https://wa.me/923102492119' }}" 
        class="db-dock-center-btn"
        aria-label="{{ section.settings.center_label | default: 'Hot Deals' }}"
        {% if section.settings.center_action == 'cart' %}
          on:click="#cart-drawer/showDialog"
          onclick="event.preventDefault(); const d = document.getElementById('cart-drawer'); if(d) d.showModal ? d.showModal() : d.setAttribute('open', '');"
        {% endif %}
      >
        {% case section.settings.center_icon %}
          {% when 'whatsapp' %}
            <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          {% when 'cart' %}
            <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          {% when 'heart' %}
            <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          {% else %}
            {% comment %} Lightning / Special Deal Icon (SS Style) {% endcomment %}
            <svg class="db-dock-center-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
        {% endcase %}
      </a>
    </div>

    {% comment %} 4. Track Order / Offers Tab {% endcomment %}
    <a href="{{ section.settings.tab4_link | default: '/pages/track-order' }}" class="db-dock-item {% if current_path contains '/pages/track-order' %}active{% endif %}">
      <div class="db-dock-icon-wrap">
        <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="1"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <span class="db-dock-label">{{ section.settings.tab4_label | default: 'Track' }}</span>
    </a>

    {% comment %} 5. Profile / Support Tab {% endcomment %}
    <a href="{{ section.settings.tab5_link | default: '/pages/shipping-returns' }}" class="db-dock-item {% if current_path contains '/pages/shipping-returns' or current_path contains '/pages/contact' %}active{% endif %}">
      <div class="db-dock-icon-wrap">
        <svg class="db-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>
      <span class="db-dock-label">{{ section.settings.tab5_label | default: 'Profile' }}</span>
    </a>
  </nav>
{% endif %}

{% schema %}
{
  "name": "Mobile Bottom Dock",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_bottom_nav",
      "label": "Enable Mobile Bottom Navigation Dock",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Dock Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active Tab Color",
      "default": "#00b853"
    },
    {
      "type": "color",
      "id": "inactive_color",
      "label": "Inactive Tab Color",
      "default": "#64748b"
    },
    {
      "type": "header",
      "content": "Center Elevated Floating Button"
    },
    {
      "type": "color",
      "id": "center_btn_bg",
      "label": "Center Button Background Color",
      "default": "#00b853"
    },
    {
      "type": "select",
      "id": "center_icon",
      "label": "Center Button Icon",
      "options": [
        { "value": "deal", "label": "⚡ Lightning Deal" },
        { "value": "whatsapp", "label": "💬 WhatsApp Support" },
        { "value": "cart", "label": "🛍️ Shopping Cart" },
        { "value": "heart", "label": "❤️ Wishlist / Favorite" }
      ],
      "default": "deal"
    },
    {
      "type": "select",
      "id": "center_action",
      "label": "Center Button Action",
      "options": [
        { "value": "link", "label": "Navigate to Link" },
        { "value": "cart", "label": "Open Cart Drawer" }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "center_link",
      "label": "Center Button Link (if Action is Link)",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Tab 1 (Home)"
    },
    {
      "type": "text",
      "id": "tab1_label",
      "label": "Tab 1 Label",
      "default": "Home"
    },
    {
      "type": "url",
      "id": "tab1_link",
      "label": "Tab 1 Link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Tab 2 (Explore)"
    },
    {
      "type": "text",
      "id": "tab2_label",
      "label": "Tab 2 Label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "tab2_link",
      "label": "Tab 2 Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Tab 4 (Track Order)"
    },
    {
      "type": "text",
      "id": "tab4_label",
      "label": "Tab 4 Label",
      "default": "Track"
    },
    {
      "type": "url",
      "id": "tab4_link",
      "label": "Tab 4 Link",
      "default": "/pages/track-order"
    },
    {
      "type": "header",
      "content": "Tab 5 (Profile / Support)"
    },
    {
      "type": "text",
      "id": "tab5_label",
      "label": "Tab 5 Label",
      "default": "Profile"
    },
    {
      "type": "url",
      "id": "tab5_link",
      "label": "Tab 5 Link",
      "default": "/pages/shipping-returns"
    }
  ],
  "presets": [
    {
      "name": "Mobile Bottom Dock"
    }
  ]
}
{% endschema %}
