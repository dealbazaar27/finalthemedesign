{% liquid
  assign products_per_page = section.settings.products_per_page | default: 24
  assign search_products = search.results | where: 'object_type', 'product'
  assign results_count = search_products.size
%}

<div class="boat-search-page-wrapper">
  
  <div class="boat-search-header-container">
    <div class="boat-search-title-row">
      <h1 class="boat-search-main-heading">
        {% if search.performed %}
          Search <span class="boat-search-highlight">Results</span>
        {% else %}
          Search <span class="boat-search-highlight">Products</span>
        {% endif %}
      </h1>
      <div class="boat-search-red-line"></div>
    </div>

    {% comment %} Modern Search Bar Form with Live Predictive Auto-Suggestions {% endcomment %}
    <div class="boat-search-form-wrapper">
      <form action="{{ routes.search_url }}" method="get" role="search" class="boat-search-bar-form">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        
        <div class="boat-search-input-box">
          <svg class="boat-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          <input 
            type="search" 
            name="q" 
            id="BoatSearchInput"
            value="{{ search.terms | escape }}" 
            placeholder="{{ section.settings.placeholder_text | default: 'Type to search products, deals, brands...' }}"
            class="boat-search-text-input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >

          {% if search.terms != blank %}
            <a href="{{ routes.search_url }}" class="boat-search-clear-btn" aria-label="Clear search">✕</a>
          {% endif %}

          <button type="submit" class="boat-search-btn-submit">
            <span>Search</span>
          </button>
        </div>
      </form>

      {% comment %} Live Predictive Auto-Suggestions Dropdown {% endcomment %}
      <div class="boat-search-suggestions-dropdown" id="BoatSearchSuggestionsDropdown" style="display: none;">
        <div class="boat-search-suggestions-header">
          <span>✨ Suggested Products</span>
        </div>
        <div class="boat-search-suggestions-list" id="BoatSearchSuggestionsList">
          <!-- Populated live via JS as user types -->
        </div>
        <a href="#" class="boat-search-view-all-btn" id="BoatSearchViewAllLink" style="display: none;">
          View all matching results for "<span id="BoatSearchViewAllQuery"></span>" →
        </a>
      </div>
    </div>

    {% if search.performed %}
      <div class="boat-search-meta-info">
        {% if results_count > 0 %}
          Showing <strong>{{ results_count }}</strong> {% if results_count == 1 %}product{% else %}products{% endif %} for "<strong>{{ search.terms | escape }}</strong>"
        {% else %}
          No results found for "<strong>{{ search.terms | escape }}</strong>"
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% comment %} Results Grid / Empty State {% endcomment %}
  <div class="boat-search-results-area">
    {% paginate search.results by products_per_page %}
      {% if search.performed and results_count > 0 %}
        <div class="boat-search-grid">
          {% for item in search_products %}
            <div class="boat-search-grid-item">
              {% render 'boat-product-card-item', product: item %}
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="boat-search-pagination">
            {{ paginate | default_pagination: next: 'Next ›', previous: '‹ Prev' }}
          </div>
        {% endif %}

      {% elsif search.performed and results_count == 0 %}
        <div class="boat-search-empty-state">
          <div class="boat-search-empty-icon">🔍</div>
          <h2 class="boat-search-empty-title">We couldn't find any matches</h2>
          <p class="boat-search-empty-desc">Please check the spelling or try searching for something else.</p>
          
          {% assign fallback_collection = section.settings.fallback_collection | default: collections.all %}
          {% if fallback_collection != blank and fallback_collection.products.size > 0 %}
            <div class="boat-search-trending-section">
              <h3 class="boat-search-trending-title">🔥 Popular Products You Might Like</h3>
              <div class="boat-search-grid">
                {% for product in fallback_collection.products limit: 8 %}
                  <div class="boat-search-grid-item">
                    {% render 'boat-product-card-item', product: product %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

      {% else %}
        {% assign default_col = section.settings.fallback_collection | default: collections.all %}
        {% if default_col != blank and default_col.products.size > 0 %}
          <div class="boat-search-trending-section">
            <h3 class="boat-search-trending-title">🔥 Explore Trending Products</h3>
            <div class="boat-search-grid">
              {% for product in default_col.products limit: 12 %}
                <div class="boat-search-grid-item">
                  {% render 'boat-product-card-item', product: product %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endif %}
    {% endpaginate %}
  </div>

</div>

<style>
  .boat-search-page-wrapper {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    padding: 30px 16px 60px 16px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
  }

  .boat-search-header-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 36px;
    gap: 16px;
  }

  .boat-search-title-row {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .boat-search-main-heading {
    font-size: 2rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 4px 0;
    letter-spacing: -0.5px;
  }

  .boat-search-highlight {
    color: #0f172a;
    position: relative;
    display: inline-block;
  }

  .boat-search-red-line {
    width: 60px;
    height: 4px;
    background: #d8232a;
    border-radius: 2px;
    margin-top: 4px;
  }

  /* Search Form & Wrapper */
  .boat-search-form-wrapper {
    position: relative;
    width: 100%;
    max-width: 680px;
    margin: 8px auto 0 auto;
    z-index: 50;
  }

  .boat-search-bar-form {
    width: 100%;
  }

  .boat-search-input-box {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 40px;
    padding: 4px 6px 4px 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-search-input-box:focus-within {
    border-color: #0f172a;
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.12);
  }

  .boat-search-icon {
    color: #64748b;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .boat-search-text-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    font-weight: 600;
    color: #0f172a;
    background: transparent;
    padding: 8px 0;
    min-width: 0;
  }

  .boat-search-text-input::placeholder {
    color: #94a3b8;
    font-weight: 500;
  }

  .boat-search-clear-btn {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .boat-search-clear-btn:hover {
    color: #0f172a;
  }

  .boat-search-btn-submit {
    background: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 30px;
    padding: 10px 24px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .boat-search-btn-submit:hover {
    background: #d8232a;
    transform: scale(1.02);
  }

  /* Live Suggestions Dropdown */
  .boat-search-suggestions-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    text-align: left;
    z-index: 999;
    animation: fadeInDropdown 0.2s ease;
  }

  @keyframes fadeInDropdown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .boat-search-suggestions-header {
    padding: 10px 16px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #64748b;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
  }

  .boat-search-suggestions-list {
    max-height: 380px;
    overflow-y: auto;
  }

  .boat-suggestion-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid #f1f5f9;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .boat-suggestion-item:last-child {
    border-bottom: none;
  }

  .boat-suggestion-item:hover {
    background: #f8fafc;
  }

  .boat-suggestion-thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .boat-suggestion-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boat-suggestion-no-img {
    font-size: 20px;
  }

  .boat-suggestion-details {
    flex: 1;
    min-width: 0;
  }

  .boat-suggestion-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .boat-highlight-matched {
    color: #d8232a;
    font-weight: 900;
    background: #fee2e2;
    border-radius: 2px;
    padding: 0 2px;
  }

  .boat-suggestion-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 3px;
  }

  .boat-suggestion-price {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-suggestion-compare {
    font-size: 0.78rem;
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 600;
  }

  .boat-suggestion-arrow {
    color: #cbd5e1;
    font-size: 1.25rem;
    font-weight: 700;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .boat-suggestion-item:hover .boat-suggestion-arrow {
    color: #0f172a;
    transform: translateX(3px);
  }

  .boat-search-view-all-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    background: #f1f5f9;
    color: #0f172a;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    border-top: 1px solid #e2e8f0;
    transition: background 0.15s ease;
  }

  .boat-search-view-all-btn:hover {
    background: #e2e8f0;
    color: #d8232a;
  }

  .boat-search-no-match {
    padding: 16px;
    text-align: center;
    color: #64748b;
    font-size: 0.9rem;
  }

  .boat-search-meta-info {
    font-size: 0.95rem;
    color: #475569;
    margin-top: 4px;
  }

  /* Product Grid */
  .boat-search-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .boat-search-grid-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  /* Pagination */
  .boat-search-pagination {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .boat-search-pagination span,
  .boat-search-pagination a {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .boat-search-pagination .current {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .boat-search-pagination a:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  /* Empty State */
  .boat-search-empty-state {
    text-align: center;
    padding: 20px 0 40px 0;
  }

  .boat-search-empty-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .boat-search-empty-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .boat-search-empty-desc {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0 0 32px 0;
  }

  .boat-search-trending-section {
    margin-top: 40px;
    text-align: left;
  }

  .boat-search-trending-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 16px 0;
  }

  /* Responsive Breakpoints */
  @media screen and (max-width: 1024px) {
    .boat-search-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }

  @media screen and (max-width: 640px) {
    .boat-search-page-wrapper {
      padding: 20px 10px 48px 10px;
    }

    .boat-search-main-heading {
      font-size: 1.5rem;
    }

    .boat-search-input-box {
      padding: 3px 4px 3px 12px;
    }

    .boat-search-text-input {
      font-size: 0.88rem;
    }

    .boat-search-btn-submit {
      padding: 8px 16px;
      font-size: 0.85rem;
    }

    /* 2 Columns on Mobile matching Deals & Store Layout */
    .boat-search-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .boat-search-meta-info {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  // Live Instant Predictive Search Dropdown as Customer Types
  (function initLivePredictiveSearch() {
    const input = document.getElementById('BoatSearchInput');
    const dropdown = document.getElementById('BoatSearchSuggestionsDropdown');
    const list = document.getElementById('BoatSearchSuggestionsList');
    const viewAllLink = document.getElementById('BoatSearchViewAllLink');
    const viewAllQuery = document.getElementById('BoatSearchViewAllQuery');

    if (!input || !dropdown || !list) return;

    let debounceTimer = null;

    input.addEventListener('input', function() {
      const q = this.value.trim();
      clearTimeout(debounceTimer);

      if (q.length < 1) {
        dropdown.style.display = 'none';
        list.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(() => {
        fetchSuggestions(q);
      }, 180);
    });

    async function fetchSuggestions(query) {
      try {
        const url = `/predictive_search.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6&resources[options][fields]=title,product_type,variants.title,vendor`;
        const res = await fetch(url);
        if (!res.ok) return;
        const data = await res.json();
        const products = data.resources?.results?.products || [];

        if (products.length === 0) {
          list.innerHTML = `<div class="boat-search-no-match">No products matching "<strong>${escapeHtml(query)}</strong>"</div>`;
          if (viewAllLink) viewAllLink.style.display = 'none';
          dropdown.style.display = 'block';
          return;
        }

        let html = '';
        products.forEach(p => {
          const imgUrl = p.image || (p.featured_image && p.featured_image.url) || '';
          const priceFormatted = p.price ? 'Rs.' + Math.floor(p.price).toLocaleString() : '';
          const comparePriceFormatted = p.compare_at_price && p.compare_at_price > p.price ? 'Rs.' + Math.floor(p.compare_at_price).toLocaleString() : '';

          html += `
            <a href="${p.url}" class="boat-suggestion-item">
              <div class="boat-suggestion-thumb">
                ${imgUrl ? `<img src="${imgUrl}" alt="${escapeHtml(p.title)}" width="48" height="48" loading="lazy">` : `<div class="boat-suggestion-no-img">🛍️</div>`}
              </div>
              <div class="boat-suggestion-details">
                <div class="boat-suggestion-title">${highlightQuery(p.title, query)}</div>
                <div class="boat-suggestion-price-row">
                  <span class="boat-suggestion-price">${priceFormatted}</span>
                  ${comparePriceFormatted ? `<span class="boat-suggestion-compare">${comparePriceFormatted}</span>` : ''}
                </div>
              </div>
              <span class="boat-suggestion-arrow">›</span>
            </a>
          `;
        });

        list.innerHTML = html;

        if (viewAllLink && viewAllQuery) {
          viewAllQuery.textContent = query;
          viewAllLink.href = `/search?type=product&q=${encodeURIComponent(query)}`;
          viewAllLink.style.display = 'flex';
        }

        dropdown.style.display = 'block';

      } catch (err) {
        console.error('Error fetching search suggestions:', err);
      }
    }

    function highlightQuery(text, query) {
      if (!query) return escapeHtml(text);
      const safeQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${safeQuery})`, 'gi');
      return escapeHtml(text).replace(regex, '<span class="boat-highlight-matched">$1</span>');
    }

    function escapeHtml(str) {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Close dropdown on outside click
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.style.display = 'none';
      }
    });

    // Reopen dropdown on input focus if query has text
    input.addEventListener('focus', function() {
      if (this.value.trim().length >= 1 && list.innerHTML.trim().length > 0) {
        dropdown.style.display = 'block';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Deal Bazaar Search Page",
  "tag": "section",
  "class": "section-boat-search-page",
  "settings": [
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Search Input Placeholder",
      "default": "Type to search products, deals, brands..."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Trending / Fallback Collection",
      "info": "Shown when no search results are found or before searching"
    }
  ],
  "presets": [
    {
      "name": "Deal Bazaar Search Page"
    }
  ]
}
{% endschema %}
