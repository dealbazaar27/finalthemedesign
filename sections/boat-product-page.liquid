{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_price = selected_variant.compare_at_price
  
  if compare_price > price
    assign discount_percent = compare_price | minus: price | times: 100.0 | divided_by: compare_price | round
  else
    assign discount_percent = 0
  endif

  assign form_id = 'BoatProductPageForm-' | append: product.id
%}

<div class="boat-pdp-container">
  
  {% comment %} --- Top Breadcrumb Navigation --- {% endcomment %}
  <nav class="boat-pdp-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="boat-pdp-breadcrumb__sep">›</span>
    {% if collection != blank %}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% elsif product.collections.size > 0 %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% endif %}
    {% if product.type != blank %}
      <span>{{ product.type | escape }}</span>
      <span class="boat-pdp-breadcrumb__sep">›</span>
    {% endif %}
    <span class="boat-pdp-breadcrumb__current">{{ product.title | escape }}</span>
  </nav>

  {% comment %} --- Main Product 2-Column Grid --- {% endcomment %}
  <div class="boat-pdp-layout">
    
    {% comment %} === Left Column: Media Gallery === {% endcomment %}
    <div class="boat-pdp-gallery-col">
      <div class="boat-pdp-gallery-inner">
        
        {% comment %} Left Vertical Thumbnails {% endcomment %}
        {% if product.media.size > 1 %}
          <div class="boat-pdp-thumbs" id="BoatPdpThumbs">
            {% for media in product.media %}
              <button 
                type="button" 
                class="boat-pdp-thumb-btn{% if forloop.first %} active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-src="{{ media | image_url: width: 1000 }}"
                onclick="switchBoatPdpImage(this, '{{ media | image_url: width: 1000 }}')"
                aria-label="Thumbnail {{ forloop.index }}"
              >
                <img 
                  src="{{ media | image_url: width: 140, height: 140 }}" 
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="64"
                  height="64"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% comment %} Main Featured Image Display {% endcomment %}
        <div class="boat-pdp-main-image-wrapper">
          <div class="boat-pdp-main-image-box">
            {% assign initial_img = selected_variant.featured_image | default: product.featured_image %}
            <img 
              id="BoatPdpMainImage"
              src="{{ initial_img | image_url: width: 1000 }}" 
              alt="{{ product.title | escape }}"
              class="boat-pdp-main-image"
              width="600"
              height="600"
            >

            {% if product.media.size > 1 %}
              <button type="button" class="boat-pdp-arrow-btn boat-pdp-arrow-btn--prev" onclick="prevBoatPdpImage()" aria-label="Previous image">‹</button>
              <button type="button" class="boat-pdp-arrow-btn boat-pdp-arrow-btn--next" onclick="nextBoatPdpImage()" aria-label="Next image">›</button>
            {% endif %}
          </div>

          {% comment %} Countdown Flash Sale Timer Bar {% endcomment %}
          <div class="boat-pdp-timer-bar">
            <span class="boat-pdp-timer-icon">⏳</span>
            <span class="boat-pdp-timer-label">Flash Sale Ends In:</span>
            <span class="boat-pdp-timer-digits" id="boatPdpCountdown">04h : 02m : 19s</span>
          </div>
        </div>

      </div>
    </div>

    {% comment %} === Right Column: Product Information & Offers === {% endcomment %}
    <div class="boat-pdp-info-col">
      
      {% comment %} 1. Review Rating Badge {% endcomment %}
      <div class="boat-pdp-rating-row">
        <span class="boat-pdp-star">★</span>
        <span class="boat-pdp-score">4.8</span>
        <span class="boat-pdp-count">(528)</span>
        <span class="boat-pdp-verified-icon">✔</span>
      </div>

      {% comment %} 2. Product Title & Subtitle {% endcomment %}
      <h1 class="boat-pdp-title">{{ product.title }}</h1>
      
      <div class="boat-pdp-subtitle">
        {% if product.metafields.custom.subtitle != blank %}
          {{ product.metafields.custom.subtitle }}
        {% elsif product.description != blank %}
          {{ product.description | strip_html | truncatewords: 22 }}
        {% else %}
          Wireless Earbuds with Massive Playback of upto 40 Hours, IPX5 Water & Sweat Resistance, IWP Technology Interface
        {% endif %}
      </div>

      {% comment %} 3. Price Row {% endcomment %}
      <div class="boat-pdp-price-offer-box">
        <div class="boat-pdp-price-group">
          <div class="boat-pdp-price-main">
            <span class="boat-pdp-price" id="BoatPdpPrice">{{ price | money_without_trailing_zeros }}</span>
            <span class="boat-pdp-compare-price" id="BoatPdpCompare" style="{% unless compare_price > price %}display: none;{% endunless %}">
              {{ compare_price | money_without_trailing_zeros }}
            </span>
            <span class="boat-pdp-discount" id="BoatPdpDiscount" style="{% unless compare_price > price %}display: none;{% endunless %}">
              {{ discount_percent }}% Off
            </span>
          </div>
          <div class="boat-pdp-tax-text">MRP (Inclusive of all taxes)</div>
        </div>
      </div>

      {% comment %} --- Form for Cart Add & Dynamic Variant Selection --- {% endcomment %}
      <form action="/cart/add" method="post" id="{{ form_id }}" onsubmit="handleBoatPdpAddToCart(event, this)">
        <input type="hidden" name="id" id="BoatPdpSelectedVariantId" value="{{ selected_variant.id }}">
        
        {% comment %} 4. Multi-Option Variant Selectors (Color, Quantity, Size, Pack, etc.) {% endcomment %}
        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            {% assign opt_name_lower = option.name | downcase %}
            {% assign is_color = false %}
            {% if opt_name_lower contains 'color' or opt_name_lower contains 'colour' or opt_name_lower contains 'shade' %}
              {% assign is_color = true %}
            {% endif %}

            <div class="boat-pdp-variant-section">
              <div class="boat-pdp-variant-label">
                Choose your {{ option.name }} : 
                <span class="boat-pdp-variant-val" id="BoatPdpOptVal-{{ option_index }}">{{ option.selected_value }}</span>
              </div>

              <div class="boat-pdp-swatches-grid">
                {% for value in option.values %}
                  {% assign swatch_variant = null %}
                  {% for variant in product.variants %}
                    {% if variant.options[option_index] == value %}
                      {% assign swatch_variant = variant %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% if is_color %}
                    <button 
                      type="button" 
                      class="boat-pdp-opt-btn boat-pdp-swatch-box{% if option.selected_value == value %} active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-option-value="{{ value | escape }}"
                      onclick="handleOptionSelect(this)"
                      aria-label="{{ value | escape }}"
                    >
                      {% if swatch_variant.featured_image != blank %}
                        <img src="{{ swatch_variant.featured_image | image_url: width: 120, height: 120 }}" alt="{{ value | escape }}" loading="lazy">
                      {% else %}
                        <span>{{ value }}</span>
                      {% endif %}
                    </button>
                  {% else %}
                    <button 
                      type="button" 
                      class="boat-pdp-opt-btn boat-pdp-pill-btn{% if option.selected_value == value %} active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-option-value="{{ value | escape }}"
                      onclick="handleOptionSelect(this)"
                    >
                      <span>{{ value }}</span>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% comment %} Quantity Stepper Selector {% endcomment %}
        <div class="boat-pdp-qty-wrapper">
          <span class="boat-pdp-qty-label">Quantity :</span>
          <div class="boat-pdp-qty-stepper">
            <button type="button" class="boat-pdp-qty-btn" onclick="changePdpQty(-1)" aria-label="Decrease quantity">−</button>
            <input type="number" id="BoatPdpQuantity" name="quantity" value="1" min="1" class="boat-pdp-qty-input" readonly>
            <button type="button" class="boat-pdp-qty-btn" onclick="changePdpQty(1)" aria-label="Increase quantity">+</button>
          </div>
        </div>

        {% comment %} 5. DEAL Section (Above Buttons) {% endcomment %}
        <div class="boat-pdp-offers-section">
          <div class="boat-pdp-card-title">🔥 DEAL</div>
          <div class="boat-pdp-offers-grid">
            
            <div class="boat-pdp-offer-card">
              <div class="boat-pdp-offer-badge">MOST POPULAR</div>
              <div class="boat-pdp-offer-inner">
                <div class="boat-pdp-offer-qty">Buy 2 or more</div>
                <div class="boat-pdp-offer-disc">Get 6% Off</div>
                <div class="boat-pdp-offer-code" onclick="copyBoatCoupon('BOAT6', this)">Code: <strong>BOAT6</strong></div>
              </div>
            </div>

            <div class="boat-pdp-offer-card">
              <div class="boat-pdp-offer-badge">BEST VALUE</div>
              <div class="boat-pdp-offer-inner">
                <div class="boat-pdp-offer-qty">Buy 5 or more</div>
                <div class="boat-pdp-offer-disc">Get 7% Off</div>
                <div class="boat-pdp-offer-code" onclick="copyBoatCoupon('BOAT7', this)">Code: <strong>BOAT7</strong></div>
              </div>
            </div>

            <div class="boat-pdp-offer-card">
              <div class="boat-pdp-offer-badge">MOST SAVINGS</div>
              <div class="boat-pdp-offer-inner">
                <div class="boat-pdp-offer-qty">Buy 10 or more</div>
                <div class="boat-pdp-offer-disc">Get 10% Off</div>
                <div class="boat-pdp-offer-code" onclick="copyBoatCoupon('BOAT10', this)">Code: <strong>BOAT10</strong></div>
              </div>
            </div>

          </div>
        </div>

        {% comment %} 6. Action Buttons (Add to Cart + Buy Now to Checkout) {% endcomment %}
        <div class="boat-pdp-cta-group">
          <button 
            type="submit" 
            class="boat-pdp-btn boat-pdp-btn--atc" 
            id="BoatPdpAtcBtn"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            {% if selected_variant.available %}
              <span>Add to Cart</span>
            {% else %}
              <span>Sold Out</span>
            {% endif %}
          </button>
          
          <button 
            type="button" 
            class="boat-pdp-btn boat-pdp-btn--buy" 
            id="BoatPdpBuyBtn"
            onclick="buyNowBoatPdp('{{ form_id }}')"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            <span>Buy Now</span>
          </button>
        </div>

      </form>

    </div>

  </div>

</div>

{% comment %} Output Master Product Variants JSON {% endcomment %}
<script type="application/json" id="BoatPdpVariantsData">
  [
    {% for v in product.variants %}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "option1": {{ v.option1 | json }},
        "option2": {{ v.option2 | json }},
        "option3": {{ v.option3 | json }},
        "price": {{ v.price }},
        "compare_at_price": {{ v.compare_at_price | default: 0 }},
        "available": {{ v.available }},
        "featured_image": {% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>

<style>
  /* ------------------------------------------------------------- */
  /* boAt Authentic Product Page Styling                           */
  /* ------------------------------------------------------------- */

  .boat-pdp-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 16px 20px 48px 20px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
  }

  /* Breadcrumb */
  .boat-pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .boat-pdp-breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .boat-pdp-breadcrumb a:hover {
    color: #0f172a;
    text-decoration: underline;
  }

  .boat-pdp-breadcrumb__sep {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .boat-pdp-breadcrumb__current {
    color: #0f172a;
    font-weight: 700;
  }

  /* 2-Column Layout */
  .boat-pdp-layout {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: start;
  }

  @media screen and (max-width: 989px) {
    .boat-pdp-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Gallery Inner Layout */
  .boat-pdp-gallery-inner {
    display: flex;
    gap: 16px;
    position: sticky;
    top: 90px;
  }

  @media screen and (max-width: 749px) {
    .boat-pdp-gallery-inner {
      flex-direction: column-reverse;
      position: relative;
      top: 0;
      gap: 12px;
    }
  }

  /* Vertical Thumbnails */
  .boat-pdp-thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 68px;
    flex-shrink: 0;
    max-height: 520px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .boat-pdp-thumbs::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .boat-pdp-thumbs {
      flex-direction: row;
      width: 100%;
      max-height: none;
      overflow-x: auto;
      padding-bottom: 4px;
    }
  }

  .boat-pdp-thumb-btn {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    padding: 2px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .boat-pdp-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .boat-pdp-thumb-btn:hover,
  .boat-pdp-thumb-btn.active {
    border-color: #0f172a;
    box-shadow: 0 0 0 1px #0f172a;
  }

  /* Main Featured Image Box */
  .boat-pdp-main-image-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .boat-pdp-main-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #f1f5f9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .boat-pdp-main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .boat-pdp-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #0f172a;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    opacity: 0.85;
    transition: all 0.2s ease;
    z-index: 5;
  }

  .boat-pdp-arrow-btn:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }

  .boat-pdp-arrow-btn--prev { left: 12px; }
  .boat-pdp-arrow-btn--next { right: 12px; }

  /* Flash Sale Countdown Timer Bar */
  .boat-pdp-timer-bar {
    background: #fff9db;
    border: 1px solid #ffe066;
    border-radius: 12px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-timer-digits {
    color: #d8232a;
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.5px;
  }

  /* Right Information Column */
  .boat-pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Rating Row */
  .boat-pdp-rating-row {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-star { color: #f59e0b; font-size: 1rem; }
  .boat-pdp-count { color: #64748b; font-weight: 600; font-size: 0.8rem; }
  .boat-pdp-verified-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #10b981;
    color: #ffffff;
    font-size: 9px;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    margin-left: 2px;
  }

  /* Title & Subtitle */
  .boat-pdp-title {
    font-size: 1.75rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .boat-pdp-subtitle {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.45;
    font-weight: 500;
  }

  /* Price Row */
  .boat-pdp-price-offer-box {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
  }

  .boat-pdp-price-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .boat-pdp-price {
    font-size: 1.6rem;
    font-weight: 900;
    color: #0f172a;
  }

  .boat-pdp-compare-price {
    font-size: 0.95rem;
    text-decoration: line-through;
    color: #94a3b8;
    font-weight: 500;
  }

  .boat-pdp-discount {
    font-size: 0.95rem;
    font-weight: 800;
    color: #00b853;
  }

  .boat-pdp-tax-text {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 2px;
  }

  /* Option / Swatch / Pill Selectors */
  .boat-pdp-variant-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .boat-pdp-variant-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-variant-val {
    font-weight: 700;
    color: #475569;
  }

  .boat-pdp-swatches-grid {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .boat-pdp-swatch-box {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 2px solid #e2e8f0;
    background: #ffffff;
    padding: 2px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .boat-pdp-swatch-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .boat-pdp-swatch-box.active {
    border-color: #0f172a;
    box-shadow: 0 0 0 2px #38bdf8;
    transform: scale(1.04);
  }

  .boat-pdp-pill-btn {
    padding: 8px 16px;
    border-radius: 20px;
    border: 1.5px solid #cbd5e1;
    background: #f8fafc;
    color: #1e293b;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .boat-pdp-pill-btn:hover {
    border-color: #0f172a;
    background: #ffffff;
  }

  .boat-pdp-pill-btn.active {
    border-color: #0f172a;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
  }

  /* Quantity Stepper */
  .boat-pdp-qty-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }

  .boat-pdp-qty-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  .boat-pdp-qty-stepper {
    display: flex;
    align-items: center;
    background: #f1f5f9;
    border-radius: 24px;
    padding: 3px 6px;
    border: 1px solid #e2e8f0;
  }

  .boat-pdp-qty-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-size: 1.1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
  }

  .boat-pdp-qty-btn:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .boat-pdp-qty-input {
    width: 38px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    outline: none;
    -moz-appearance: textfield;
  }

  .boat-pdp-qty-input::-webkit-outer-spin-button,
  .boat-pdp-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* DEAL Section (Above Buttons) */
  .boat-pdp-offers-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 10px;
  }

  .boat-pdp-card-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.2px;
  }

  .boat-pdp-offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  @media screen and (max-width: 600px) {
    .boat-pdp-offers-grid {
      grid-template-columns: 1fr;
    }
  }

  .boat-pdp-offer-card {
    background: #e6fcf5;
    border: 1.5px solid #a3e635;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .boat-pdp-offer-badge {
    background: #00a651;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .boat-pdp-offer-inner {
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .boat-pdp-offer-qty {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f172a;
  }

  .boat-pdp-offer-disc {
    font-size: 0.8rem;
    font-weight: 800;
    color: #00875a;
  }

  .boat-pdp-offer-code {
    background: rgba(255, 255, 255, 0.9);
    border: 1px dashed #00a651;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    width: 100%;
    margin-top: 4px;
    transition: all 0.2s ease;
  }

  .boat-pdp-offer-code:hover {
    background: #ffffff;
    border-style: solid;
  }

  /* Action CTA Buttons */
  .boat-pdp-cta-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 14px 0 8px 0;
  }

  .boat-pdp-btn {
    flex: 1;
    height: 48px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .boat-pdp-btn--atc {
    background: #0f172a;
    color: #ffffff;
  }

  .boat-pdp-btn--atc:hover {
    background: #1e293b;
    transform: translateY(-1px);
  }

  .boat-pdp-btn--buy {
    background: #00b853;
    color: #ffffff;
  }

  .boat-pdp-btn--buy:hover {
    background: #009944;
    transform: translateY(-1px);
  }
</style>

<script>
  // Image Thumbnail Switcher
  function switchBoatPdpImage(btn, imgSrc) {
    const mainImg = document.getElementById('BoatPdpMainImage');
    if (mainImg && imgSrc) {
      mainImg.src = imgSrc;
    }

    const allThumbs = document.querySelectorAll('.boat-pdp-thumb-btn');
    allThumbs.forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
  }

  // Previous & Next Arrow Handlers
  function prevBoatPdpImage() {
    const activeThumb = document.querySelector('.boat-pdp-thumb-btn.active');
    if (activeThumb && activeThumb.previousElementSibling) {
      activeThumb.previousElementSibling.click();
      activeThumb.previousElementSibling.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function nextBoatPdpImage() {
    const activeThumb = document.querySelector('.boat-pdp-thumb-btn.active');
    if (activeThumb && activeThumb.nextElementSibling) {
      activeThumb.nextElementSibling.click();
      activeThumb.nextElementSibling.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  // Live Flash Sale Countdown Timer
  (function() {
    let totalSeconds = 4 * 3600 + 2 * 60 + 19;
    const timerElem = document.getElementById('boatPdpCountdown');
    if (!timerElem) return;

    setInterval(() => {
      if (totalSeconds > 0) totalSeconds--;
      const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
      const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
      const seconds = String(totalSeconds % 60).padStart(2, '0');
      timerElem.textContent = `${hours}h : ${minutes}m : ${seconds}s`;
    }, 1000);
  })();

  // Quantity Stepper Handler
  function changePdpQty(delta) {
    const input = document.getElementById('BoatPdpQuantity');
    if (!input) return;
    let val = parseInt(input.value, 10) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  }

  // Master Variant Resolver & Multi-Option Matching
  const variantsData = JSON.parse(document.getElementById('BoatPdpVariantsData').textContent);
  let selectedOptions = [
    {% for option in product.options_with_values %}
      {{ option.selected_value | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  function formatMoneyWithoutDecimals(cents) {
    const amount = Math.floor(cents / 100);
    return 'Rs.' + amount.toLocaleString();
  }

  function handleOptionSelect(btn) {
    const optIndex = parseInt(btn.dataset.optionIndex, 10);
    const optValue = btn.dataset.optionValue;

    selectedOptions[optIndex] = optValue;

    // Update active class
    const parentGrid = btn.closest('.boat-pdp-swatches-grid');
    if (parentGrid) {
      parentGrid.querySelectorAll('.boat-pdp-opt-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    // Update option title label
    const labelElem = document.getElementById('BoatPdpOptVal-' + optIndex);
    if (labelElem) labelElem.textContent = optValue;

    // Find matching variant from master variantsData
    const matchedVariant = variantsData.find(v => {
      if (selectedOptions.length === 1) return v.option1 === selectedOptions[0];
      if (selectedOptions.length === 2) return v.option1 === selectedOptions[0] && v.option2 === selectedOptions[1];
      if (selectedOptions.length === 3) return v.option1 === selectedOptions[0] && v.option2 === selectedOptions[1] && v.option3 === selectedOptions[2];
      return false;
    });

    if (matchedVariant) {
      // Update hidden input
      const idInput = document.getElementById('BoatPdpSelectedVariantId');
      if (idInput) idInput.value = matchedVariant.id;

      // Update Price
      const priceElem = document.getElementById('BoatPdpPrice');
      if (priceElem) priceElem.textContent = formatMoneyWithoutDecimals(matchedVariant.price);

      // Update Compare Price & Discount
      const compElem = document.getElementById('BoatPdpCompare');
      const discElem = document.getElementById('BoatPdpDiscount');
      if (matchedVariant.compare_at_price > matchedVariant.price) {
        const discPercent = Math.round(((matchedVariant.compare_at_price - matchedVariant.price) * 100) / matchedVariant.compare_at_price);
        if (compElem) {
          compElem.textContent = formatMoneyWithoutDecimals(matchedVariant.compare_at_price);
          compElem.style.display = 'inline';
        }
        if (discElem) {
          discElem.textContent = discPercent + '% Off';
          discElem.style.display = 'inline';
        }
      } else {
        if (compElem) compElem.style.display = 'none';
        if (discElem) discElem.style.display = 'none';
      }

      // Update Main Image if variant has image
      if (matchedVariant.featured_image) {
        const mainImg = document.getElementById('BoatPdpMainImage');
        if (mainImg) mainImg.src = matchedVariant.featured_image;
      }

      // Update Buttons
      const atcBtn = document.getElementById('BoatPdpAtcBtn');
      const buyBtn = document.getElementById('BoatPdpBuyBtn');
      if (atcBtn) {
        atcBtn.disabled = !matchedVariant.available;
        atcBtn.innerHTML = matchedVariant.available ? '<span>Add to Cart</span>' : '<span>Sold Out</span>';
      }
      if (buyBtn) buyBtn.disabled = !matchedVariant.available;
    } else {
      // Combination unavailable
      const atcBtn = document.getElementById('BoatPdpAtcBtn');
      const buyBtn = document.getElementById('BoatPdpBuyBtn');
      if (atcBtn) {
        atcBtn.disabled = true;
        atcBtn.innerHTML = '<span>Unavailable</span>';
      }
      if (buyBtn) buyBtn.disabled = true;
    }
  }

  // Real-Time Ajax Add To Cart with Instant Header Cart & Drawer Sync
  async function handleBoatPdpAddToCart(event, form) {
    event.preventDefault();
    const btn = form.querySelector('.boat-pdp-btn--atc');
    if (!btn || btn.disabled) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>Adding...</span>';

    const variantId = document.getElementById('BoatPdpSelectedVariantId').value;
    const qtyInput = document.getElementById('BoatPdpQuantity');
    const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity,
          sections: 'cart-drawer-section'
        })
      });
      const data = await res.json();

      if (res.ok && !data.status) {
        btn.innerHTML = '<span>✓ Added to Cart!</span>';
        btn.style.background = '#00b853';

        // 1. Instantly Update Header Cart Bubble / Count across the theme
        try {
          const cartRes = await fetch('/cart.js');
          const cartData = await cartRes.json();
          const count = cartData.item_count;

          document.querySelectorAll('.cart-bubble').forEach(b => {
            b.classList.remove('visually-hidden');
            b.style.display = 'flex';
          });
          document.querySelectorAll('.cart-bubble__text-count, [data-testid="cart-bubble"]').forEach(t => {
            t.classList.remove('hidden');
            t.textContent = count;
            t.style.display = 'inline';
          });
          document.querySelectorAll('.header-actions__cart-icon').forEach(icon => {
            if (count > 0) icon.classList.add('header-actions__cart-icon--has-cart');
          });
        } catch(e) {}

        // 2. Update Cart Drawer Inner DOM safely
        const drawerHtml = data.sections ? data.sections['cart-drawer-section'] : null;
        if (drawerHtml) {
          const parser = new DOMParser();
          const doc = parser.parseFromString(drawerHtml, 'text/html');
          const newInner = doc.querySelector('.cart-drawer__inner');
          const currentInner = document.querySelector('#cart-drawer .cart-drawer__inner');
          if (newInner && currentInner) {
            currentInner.replaceWith(newInner);
          }
        }

        // 3. Open Cart Drawer
        const drawerTrigger = document.querySelector('[data-testid="cart-drawer-trigger"], [on\\:click*="#cart-drawer/toggle"]');
        const drawer = document.getElementById('cart-drawer');
        if (drawerTrigger && !drawer?.hasAttribute('open')) {
          drawerTrigger.click();
        } else if (drawer) {
          if (typeof drawer.open === 'function') {
            drawer.open();
          } else {
            const dialog = drawer.querySelector('dialog');
            if (dialog && !dialog.open && typeof dialog.showModal === 'function') {
              dialog.showModal();
            }
            drawer.setAttribute('open', '');
          }
        }

        // Dispatch Theme Events
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
        document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: data } }));

        setTimeout(() => {
          btn.disabled = false;
          btn.style.background = '';
          btn.innerHTML = originalText;
        }, 2500);
      } else {
        btn.disabled = false;
        btn.innerHTML = originalText;
        alert(data.description || 'Could not add product to cart.');
      }
    } catch (e) {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // Direct Checkout for Buy Now Button
  async function buyNowBoatPdp(formId) {
    const variantId = document.getElementById('BoatPdpSelectedVariantId').value;
    if (!variantId) return;

    const qtyInput = document.getElementById('BoatPdpQuantity');
    const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

    const buyBtn = document.getElementById('BoatPdpBuyBtn');
    if (buyBtn) {
      buyBtn.disabled = true;
      buyBtn.innerHTML = '<span>Proceeding to Checkout...</span>';
    }

    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: quantity })
      });
      window.location.href = '/checkout';
    } catch(e) {
      window.location.href = '/checkout';
    }
  }

  // Copy Coupon Code
  function copyBoatCoupon(code, elem) {
    navigator.clipboard.writeText(code);
    const originalText = elem.innerHTML;
    elem.innerHTML = '✓ Copied ' + code;
    setTimeout(() => {
      elem.innerHTML = originalText;
    }, 1500);
  }

  // Global Delegated Click Listener to Ensure Cart Drawer (X) Close & Backdrop Always Works 100%
  document.addEventListener('click', function(e) {
    const closeBtn = e.target.closest('.theme-drawer__close-button, [on\\:click*="close"], .cart-drawer__close-button--empty');
    if (closeBtn && closeBtn.closest('#cart-drawer, .theme-drawer, cart-drawer-component')) {
      e.preventDefault();
      e.stopPropagation();
      const drawer = document.getElementById('cart-drawer');
      if (drawer) {
        if (typeof drawer.close === 'function') {
          drawer.close();
        }
        const dialog = drawer.querySelector('dialog');
        if (dialog && typeof dialog.close === 'function') {
          dialog.close();
        }
        drawer.removeAttribute('open');
      }
    }
  });
</script>

