    }

    .boat-pdp-swatch-box {
      width: 46px;
      height: 46px;
    }

    .boat-pdp-pill-btn {
      padding: 6px 12px;
      font-size: 0.8rem;
    }

    .boat-pdp-subtotal-wrapper {
      padding: 8px 12px;
      margin-top: 8px;
    }

    .boat-pdp-subtotal-label {
